---
import BaseLayout from '../../layouts/BaseLayout.astro'
import EventsBoard from '../../components/EventsBoard.astro'
import { getUpcomingEvents } from '../../lib/events/provider'
import { buildSections } from '../../lib/events/logic'
import { eventGraph } from '../../lib/structured-data'

const events = await getUpcomingEvents()

// Event JSON-LD describes `rendered`, not every event in the window. The
// board collapses a recurring series to a single entry, so emitting one node
// per occurrence would advertise dates that appear nowhere on the page —
// structured data for content the reader can't see.
const origin = Astro.site?.origin
const { rendered } = buildSections(events)
const structuredData = origin ? eventGraph(origin, rendered) : []
---

<BaseLayout
  title="What’s On | Pine Lake Covenant Church"
  description="What’s coming up at Pine Lake — Sunday gatherings, groups, family events, and ways to help out around Sammamish."
  structuredData={structuredData}
>
  <EventsBoard events={events} />
</BaseLayout>

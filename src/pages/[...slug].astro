---
import TinaIsland from '@tinacms/astro/TinaIsland.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageBody from '../components/blocks/tina/PageBody.astro'
import { getPage, listPages } from '../lib/tina/data'
import { PAGE_WRAPPER } from '../lib/tina/islands'
import { pageDescription } from '../lib/tina/page-meta'

// Renders CMS-built pages. Each entry is an MDX file: a structured hero in
// frontmatter plus a body the editor composes from the block palette. The
// filename is the URL slug (src/content/pages/church-life.mdx → /church-life/).
// Drafts show in dev and are excluded from production builds. The deployed editor
// reaches a draft, or a page saved since the last deploy, through
// src/pages/tina-preview/[...slug].astro instead.
//
// Content comes from Tina's GraphQL client rather than getCollection() +
// render(). That is what visual editing requires: the rendered DOM has to carry
// the field metadata the editor bridge maps forms onto, which a compiled MDX
// module can't provide. Two consequences worth knowing:
//
//   - `astro build` alone no longer works. getStaticPaths queries Tina, so the
//     build must run inside `tinacms build` (see `npm run build`), which starts the
//     data layer for the duration.
//   - Nothing here calls getCollection('pages') any more, but the collection in
//     src/content.config.ts is still load-bearing: Astro's content layer syncs
//     and zod-validates every *declared* collection whether or not a route loads
//     it. That check is what catches a page saved without a `hero` — the CMS
//     schema and zod catch different mistakes, so both are worth keeping.
// `index.mdx` is the home page, so it maps to `/` rather than `/index/`: a rest
// parameter of undefined is how Astro spells the root. The CMS's `ui.router` in
// tina/config.ts carries the same special case, so the editor's preview agrees.
export async function getStaticPaths() {
  const pages = await listPages()
  const published = pages.filter((page) => (import.meta.env.PROD ? !page.draft : true))
  return published.map((page) => {
    const slug = page.relativePath.replace(/\.mdx$/, '')
    return {
      params: { slug: slug === 'index' ? undefined : slug },
      props: { relativePath: page.relativePath },
    }
  })
}

const { relativePath } = Astro.props
const result = await getPage(relativePath)
const page = result.data?.pages
if (!page) return new Response('Not Found', { status: 404 })

const description = pageDescription(page)
---

{
  /* BaseLayout owns the " | Pine Lake Covenant Church" suffix; seoTitle is the
    verbatim override (the home page leads with the church and qualifies it —
    "… | Sammamish" — the shape search results want for a site root).
    `||`, not `??`, for the ''-vs-missing reason above. */
}
<BaseLayout title={page.title} seoTitle={page.seoTitle || undefined} description={description}>
  <TinaIsland name="page" wrapper={PAGE_WRAPPER} params={{ relativePath }} primary>
    <PageBody data={page} />
  </TinaIsland>
</BaseLayout>

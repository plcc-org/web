---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import Split from '../components/Split.astro'
import Band from '../components/Band.astro'
import QuoteGrid from '../components/QuoteGrid.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import { homepageQuotes } from '../data/quotes'
import { startHereLinks } from '../data/startHereLinks'
import { getImage } from 'astro:assets'
import { imageByFilename, imageAlt } from '../data/homePageImages'
import churchExterior from '../assets/images/church-exterior-1024x400.jpg'

const welcomeImage = imageByFilename('672470327_18202547344338056_2701967790999045946_n.jpg')

const momentsItems = [
  {
    image: imageByFilename('718553950_18207937192338056_7548100352354445130_n.jpg'),
    fallbackAlt: 'A parent cradling a sleeping newborn during the service',
  },
  {
    image: imageByFilename('630141203_18195791974338056_6787714522898086321_n.jpg'),
    fallbackAlt: 'A woman worshipping as the band leads on a Sunday morning',
  },
  {
    image: imageByFilename('500083306_18167175181338056_8168148552855409791_n.jpg'),
    fallbackAlt: 'People sharing a meal and conversation together',
  },
]

const base = import.meta.env.BASE_URL

// Optimized WebP poster for the hero video (needs a plain URL string).
const heroPoster = await getImage({ src: churchExterior, width: 1600, format: 'webp' })
---

<BaseLayout
  title="Pine Lake Covenant Church | Sammamish"
  description="A church in Sammamish where people discover life with Jesus together. Join us Sundays at 10:00am."
>
  <Hero
    video={`${base}video/homepage-hero.mp4`}
    poster={heroPoster.src}
    eyebrow="Pine Lake Covenant Church · Sammamish"
    title="Discovering life with Jesus together"
    subhead="Sundays at 10:00am — for kids, students, and grown-ups."
  >
    <a class="btn" href={`${base}plan-a-visit/`}>Plan a Visit</a>
  </Hero>

  <div class="canvas">
    <Split
      class="to-full"
      filename={welcomeImage ? welcomeImage.filename : 'plcc-community-family-worship.jpg'}
      alt={welcomeImage
        ? imageAlt(welcomeImage, 'Families and adults gathered in worship together')
        : 'Families and adults gathered in worship together'}
      tone="paper"
      eyebrow="Welcome"
      heading="Come as you are"
    >
      <p>
        We’re a community on a journey to find and follow Jesus together. You’re welcome here whether you’re all-in,
        just looking, quietly skeptical, or because someone in your family is dragging you along.
      </p>
      <p>
        Whether faith feels like home, a question mark, or a distant memory, there’s a place for you among us. Come
        curious, hopeful, doubtful, weary, joyful, or unsure — and feel free to participate fully, or hang back and
        observe.
      </p>
      <p><a class="btn btn--ghost" href={`${base}im-new/`}>What to expect →</a></p>
    </Split>

    <LinkCardSection links={startHereLinks} />

    <MomentsSection
      items={momentsItems}
      eyebrow="Life together"
      heading="Moments from Pine Lake"
      sectionClass="to-wide"
    />

    <Band tone="sand" eyebrow="In their words" heading="Why people have made Pine Lake their church">
      <p class="measure">A few voices from our community — and a few glimpses of life together at Pine Lake.</p>
      <QuoteGrid quotes={homepageQuotes} />
    </Band>

    <Band tone="forest" flush centered eyebrow="Visiting" heading="Come this Sunday">
      <p>
        We gather at 10:00am at 1715 228th Ave SE in Sammamish. There’s guest parking by the main entrance — walk in,
        grab a coffee, and sit wherever you like.
      </p>
      <a class="btn" href={`${base}plan-a-visit/`}>Plan a Visit</a>
    </Band>
  </div>
</BaseLayout>

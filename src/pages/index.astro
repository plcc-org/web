---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import Split from '../components/Split.astro'
import Band from '../components/Band.astro'
import QuoteCarousel from '../components/QuoteCarousel.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../lib/url'

const homeQuotes = (await getCollection('quotes'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((q) => ({ text: q.data.text, by: q.data.by }))

// The four doors off the homepage. Inline rather than a collection: they're this
// page's content and appear nowhere else, which is the same call the `new` and
// `neighbors` pages made when their link cards moved into the page that shows
// them. See docs/cms.md.
const homeLinks = [
  { href: '/about/pastors-letter/', title: 'A Welcome from our Pastor', meta: 'A personal letter from Austin Bailey.' },
  { href: '/visit/', title: 'Plan a Visit', meta: 'What Sundays are like.' },
  { href: '/families/', title: 'Families', meta: 'Kids, youth, and community.' },
  { href: '/messages/', title: 'Messages', meta: 'Watch a recent service.' },
]

const homeMoments = [
  '718553950_18207937192338056_7548100352354445130_n.jpg',
  '630141203_18195791974338056_6787714522898086321_n.jpg',
  '500083306_18167175181338056_8168148552855409791_n.jpg',
]
---

<BaseLayout
  title="Pine Lake Covenant Church | Sammamish"
  description="A church in Sammamish where people discover life with Jesus together. Join us Sundays at 10:00am."
>
  <Hero
    photos={[
      '524154872_18173482963338056_6782375928921851070_n.jpg',
      '499237357_18167175172338056_6041845435208425322_n.jpg',
      '496814139_18165842923338056_8245433015909218005_n.jpg',
      '551096105_18178844185338056_8945047004848009463_n.jpg',
      '514258192_1153019166866071_3757453336252701624_n.jpg',
    ]}
    filename="pine-lake-exterior-2026.jpg"
    eyebrow="Pine Lake Covenant Church · Sammamish"
    title="Discovering life with Jesus together"
    subhead="Sundays at 10:00am — for kids, students, and grown-ups."
  >
    <a class="btn" href={withBase('visit/')}>Plan a Visit</a>
  </Hero>

  <div class="canvas">
    <Split
      class="to-full"
      filename="672470327_18202547344338056_2701967790999045946_n.jpg"
      tone="paper"
      eyebrow="Welcome"
      heading="Come as you are"
    >
      <p>
        We’re a community on a journey to find and follow Jesus together. You’re welcome here whether you’re all-in,
        just looking, quietly skeptical, or because someone in your family is dragging you along.
      </p>
      <p>
        Whether faith feels like home, a question mark, or a distant memory, there’s a place for you among us. We don’t
        care where you are on the journey — we just want to travel with you.
      </p>
      <p><a class="btn btn--ghost" href={withBase('new/')}>What to expect →</a></p>
    </Split>

    <LinkCardSection links={homeLinks} reveal />

    <MomentsSection
      photos={homeMoments}
      eyebrow="Life together"
      heading="Moments from Pine Lake"
      sectionClass="to-wide"
      reveal
    />

    <Band
      tone="sand"
      class="band--wash"
      eyebrow="In their words"
      heading="Why people have made Pine Lake their church"
      reveal
    >
      <p class="measure">A few voices from our community — and a few glimpses of life together at Pine Lake.</p>
      <QuoteCarousel quotes={homeQuotes} />
    </Band>

    <Band tone="forest" flush centered eyebrow="Visiting" heading="Come this Sunday" reveal>
      <p>
        We gather at 10:00am at 1715 228th Ave SE in Sammamish. There’s guest parking by the main entrance — walk in,
        grab a coffee, and sit wherever you like.
      </p>
      <a class="btn" href={withBase('visit/')}>Plan a Visit</a>
    </Band>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import VignetteGrid from '../components/VignetteGrid.astro'
import QuoteGrid from '../components/QuoteGrid.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import { vignettes } from '../data/vignettes'
import { homepageQuotes } from '../data/quotes'
import { startHereLinks } from '../data/startHereLinks'
import { imageAlt, imagePublicSrc, pickImageByAnyTag } from '../data/homePageImages'
import churchExterior from '../assets/images/church-exterior-1024x400.jpg'

const momentsImage01 = pickImageByAnyTag(['community', 'social', 'gathering'])
const momentsImage02 = pickImageByAnyTag(['kids', 'family', 'youth'], [momentsImage01?.filename ?? ''])
const momentsImage03 = pickImageByAnyTag(
  ['worship', 'prayer', 'service'],
  [momentsImage01?.filename ?? '', momentsImage02?.filename ?? '']
)
const momentsImage04 = pickImageByAnyTag(
  ['youth', 'social', 'service'],
  [momentsImage01?.filename ?? '', momentsImage02?.filename ?? '', momentsImage03?.filename ?? '']
)
---

<BaseLayout
  title="Pine Lake Covenant Church | Sammamish"
  description="A church in Sammamish where people discover life with Jesus together. Join us Sundays at 10:00am."
>
  <article class="page page--wide">
    <header class="page__header">
      <h1>A church in Sammamish, discovering life with Jesus together</h1>
      <p class="page__subhead">
        Sundays at 10:00am · Families, kids, and youth are an important part of our life together
      </p>

      <p class="page__lede">
        <a href={`${import.meta.env.BASE_URL}plan-a-visit/`}>Plan a Visit</a>
        ·
        <a href={`${import.meta.env.BASE_URL}im-new/`}>I’m New Here</a>
      </p>

      <div class="hero-box">
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
          tabindex="-1"
          poster={churchExterior.src}
        >
          <source src={`${import.meta.env.BASE_URL}video/homepage-hero.mp4`} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <div class="hero-overlay">
          <span class="media__label" style="color: var(--color-stone);">A welcoming community, centered on Jesus.</span>
        </div>
      </div>
    </header>

    <LinkCardSection links={startHereLinks} />

    <section class="section welcome-hero" aria-labelledby="welcome-heading">
      <div class="welcome-hero__inner">
        <h2 id="welcome-heading">Welcome</h2>
        <p class="welcome-hero__copy">
          We’re a community on a journey to find and follow Jesus together. You’re welcome here whether you’re all-in,
          just looking, quietly skeptical, or because someone in your family is dragging you along.
        </p>

        <p class="welcome-hero__copy">
          Whether faith feels like home, a question mark, or a distant memory, there’s a place for you among us. Come as
          you are — curious, hopeful, doubtful, weary, joyful, or unsure. And feel free to participate fully, or hang
          back and observe.
        </p>
      </div>
    </section>

    <section class="section">
      <h2>Why people come to Pine Lake</h2>

      <p class="measure--medium">A few voices from our community — and a few glimpses of life together at Pine Lake.</p>

      <VignetteGrid images={vignettes} />
      <QuoteGrid quotes={homepageQuotes} />
      <p>
        <a href={`${import.meta.env.BASE_URL}stories/`}>More stories from Pine Lake</a>
      </p>
    </section>

    <section class="section">
      <h2>Moments from Pine Lake</h2>

      <div class="tile-grid">
        <div class="tile ratio-4x5">
          {
            momentsImage01 ? (
              <img
                src={imagePublicSrc(momentsImage01.filename)}
                alt={imageAlt(momentsImage01, 'People greeting each other at Pine Lake')}
                class="tile__img"
                loading="lazy"
                decoding="async"
              />
            ) : null
          }
        </div>
        <div class="tile ratio-4x5">
          {
            momentsImage02 ? (
              <img
                src={imagePublicSrc(momentsImage02.filename)}
                alt={imageAlt(momentsImage02, 'Students gathered and listening together')}
                class="tile__img"
                loading="lazy"
                decoding="async"
              />
            ) : null
          }
        </div>
        <div class="tile ratio-4x5">
          {
            momentsImage03 ? (
              <img
                src={imagePublicSrc(momentsImage03.filename)}
                alt={imageAlt(momentsImage03, 'A candid moment from church community life')}
                class="tile__img"
                loading="lazy"
                decoding="async"
              />
            ) : null
          }
        </div>
        <div class="tile ratio-4x5">
          {
            momentsImage04 ? (
              <img
                src={imagePublicSrc(momentsImage04.filename)}
                alt={imageAlt(momentsImage04, 'People connecting after a service')}
                class="tile__img"
                loading="lazy"
                decoding="async"
              />
            ) : null
          }
        </div>
      </div>

      <p>
        <a href="https://www.instagram.com/pinelakecov/" rel="noopener">See more on Instagram</a>
      </p>
    </section>

    <section class="section">
      <h2>Join us this Sunday</h2>

      <div class="split-grid">
        <div>
          <p>
            <strong>Sunday at 10:00am</strong><br />
            1715 228th Ave SE<br />
            Sammamish, WA 98075
          </p>

          <p>
            <a href={`${import.meta.env.BASE_URL}plan-a-visit/`}>Plan a Visit</a>
            ·
            <a href={`${import.meta.env.BASE_URL}families/`}>Families</a>
          </p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .welcome-hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-soft);
    background:
      radial-gradient(circle at 92% 10%, rgba(106, 149, 41, 0.2) 0%, rgba(106, 149, 41, 0) 35%),
      linear-gradient(155deg, rgba(26, 46, 12, 0.95) 0%, rgba(45, 77, 24, 0.9) 60%, rgba(106, 149, 41, 0.85) 100%);
    color: var(--color-stone);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-diffuse);
    isolation: isolate;
  }

  .welcome-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(120deg, rgba(255, 255, 255, 0.15) 0 1px, transparent 1px),
      linear-gradient(30deg, rgba(255, 255, 255, 0.1) 0 1px, transparent 1px);
    background-size:
      40px 40px,
      28px 28px;
    opacity: 0.12;
    pointer-events: none;
    z-index: -1;
  }

  .welcome-hero__inner {
    padding: clamp(1.6rem, 4vw, 3rem);
  }

  .welcome-hero h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    color: var(--color-stone);
  }

  .welcome-hero__copy {
    margin: 0.85rem 0 0;
    font-size: clamp(1.03rem, 1.4vw, 1.15rem);
    line-height: 1.75;
    text-wrap: pretty;
    color: rgba(255, 255, 255, 0.94);
    max-width: none;
    width: 100%;
  }

  @media (max-width: 768px) {
    .welcome-hero__inner {
      padding: 1.5rem;
    }
  }
</style>

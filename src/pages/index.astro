---
import BaseLayout from '../layouts/BaseLayout.astro'
import QuoteGrid from '../components/QuoteGrid.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import { homepageQuotes } from '../data/quotes'
import { startHereLinks } from '../data/startHereLinks'
import { getImage } from 'astro:assets'
import Photo from '../components/Photo.astro'
import { imageByFilename, imageAlt } from '../data/homePageImages'
import churchExterior from '../assets/images/church-exterior-1024x400.jpg'

const welcomeImage = imageByFilename('plcc-community-family-worship.jpg')

const momentsImage01 = imageByFilename('plcc-kids-storytime-stage.jpg')
const momentsImage02 = imageByFilename('plcc-worship-vocals.jpg')
const momentsImage03 = imageByFilename('649105057_18197705983338056_1797927855377785235_n.jpg')
const momentsItems = [
  { image: momentsImage01, fallbackAlt: 'People greeting each other at Pine Lake' },
  { image: momentsImage02, fallbackAlt: 'Students gathered and listening together' },
  { image: momentsImage03, fallbackAlt: 'A candid moment from church community life' },
]

const joinUsImage = imageByFilename('plcc-community-worship-cross.jpg')

// Optimized WebP poster for the hero video (needs a plain URL string).
const heroPoster = await getImage({ src: churchExterior, width: 1024, format: 'webp' })
---

<BaseLayout
  title="Pine Lake Covenant Church | Sammamish"
  description="A church in Sammamish where people discover life with Jesus together. Join us Sundays at 10:00am."
>
  <article class="page page--wide">
    <header class="page__header">
      <h1>A church in Sammamish, discovering life with Jesus together</h1>
      <p class="page__subhead">Sundays at 10:00am · Programs and activities for all ages</p>

      <div class="hero-box">
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
          tabindex="-1"
          poster={heroPoster.src}
        >
          <source src={`${import.meta.env.BASE_URL}video/homepage-hero.mp4`} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <div class="hero-overlay">
          <span class="media__label" style="color: var(--color-stone);">A welcoming community, centered on Jesus.</span>
        </div>
      </div>
    </header>

    <section class="section welcome-hero" aria-labelledby="welcome-heading">
      <div class="welcome-hero__layout">
        <div class="welcome-hero__inner">
          <h2 id="welcome-heading">Welcome</h2>
          <p class="welcome-hero__copy">
            We’re a community on a journey to find and follow Jesus together. You’re welcome here whether you’re all-in,
            just looking, quietly skeptical, or because someone in your family is dragging you along.
          </p>

          <p class="welcome-hero__copy">
            Whether faith feels like home, a question mark, or a distant memory, there’s a place for you among us. Come
            as you are — curious, hopeful, doubtful, weary, joyful, or unsure. And feel free to participate fully, or
            hang back and observe.
          </p>
        </div>

        {
          welcomeImage ? (
            <div class="welcome-hero__image-frame ratio-4x5">
              <Photo
                filename={welcomeImage.filename}
                alt={imageAlt(welcomeImage, 'Families and adults gathered in worship together')}
                class="welcome-hero__image"
                widths={[360, 720]}
                sizes="(max-width: 768px) 100vw, 360px"
              />
            </div>
          ) : null
        }
      </div>
    </section>

    <LinkCardSection links={startHereLinks} />

    <MomentsSection items={momentsItems} />

    <section class="section">
      <h2>Why people have made Pine Lake their church</h2>

      <p class="prose-measure">A few voices from our community — and a few glimpses of life together at Pine Lake.</p>

      <QuoteGrid quotes={homepageQuotes} />
    </section>

    <section class="section">
      <h2>Join us this Sunday</h2>

      <div class="split-grid">
        <div>
          <p>
            <strong>Sunday at 10:00am</strong><br />
            1715 228th Ave SE<br />
            Sammamish, WA 98075
          </p>

          <p>
            <a href={`${import.meta.env.BASE_URL}plan-a-visit/`}>Plan a Visit</a>
            ·
            <a href={`${import.meta.env.BASE_URL}families/`}>Families</a>
          </p>
        </div>

        <div class="media__frame ratio-4x3">
          {
            joinUsImage ? (
              <Photo
                filename={joinUsImage.filename}
                alt={imageAlt(joinUsImage, 'People gathered together during worship at Pine Lake')}
                class="media__img media__img--cover joinus-photo"
                widths={[420, 840]}
                sizes="(max-width: 768px) 100vw, 420px"
              />
            ) : null
          }
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .page--wide {
    margin-bottom: var(--space-s);
  }

  .welcome-hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-soft);
    background:
      radial-gradient(circle at 92% 10%, rgba(106, 149, 41, 0.2) 0%, rgba(106, 149, 41, 0) 35%),
      linear-gradient(155deg, rgba(26, 46, 12, 0.95) 0%, rgba(45, 77, 24, 0.9) 60%, rgba(106, 149, 41, 0.85) 100%);
    color: var(--color-stone);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-diffuse);
    isolation: isolate;
  }

  .welcome-hero__layout {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .welcome-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(120deg, rgba(255, 255, 255, 0.15) 0 1px, transparent 1px),
      linear-gradient(30deg, rgba(255, 255, 255, 0.1) 0 1px, transparent 1px);
    background-size:
      40px 40px,
      28px 28px;
    opacity: 0.12;
    pointer-events: none;
    z-index: -1;
  }

  .welcome-hero__inner {
    padding: clamp(1.6rem, 4vw, 3rem);
  }

  .welcome-hero__image-frame {
    border-radius: var(--radius-soft);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    margin: 1.25rem 1.25rem 1.25rem 0;
    box-shadow: var(--shadow-diffuse);
  }

  :global(.welcome-hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .split-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
    align-items: start;
  }

  .split-grid .media__frame {
    aspect-ratio: 3 / 4;
  }

  :global(.joinus-photo) {
    object-position: center 35%;
  }

  .welcome-hero h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    color: var(--color-stone);
  }

  .welcome-hero__copy {
    margin: 0.85rem 0 0;
    font-size: clamp(1.03rem, 1.4vw, 1.15rem);
    line-height: 1.75;
    text-wrap: pretty;
    color: rgba(255, 255, 255, 0.94);
    max-width: none;
    width: 100%;
  }

  @media (max-width: 768px) {
    .welcome-hero__layout {
      grid-template-columns: 1fr;
    }

    .welcome-hero__inner {
      padding: 1.5rem;
    }

    .welcome-hero__image-frame {
      margin: 0 1.5rem 1.5rem;
    }

    .split-grid {
      grid-template-columns: 1fr;
    }

    .split-grid .media__frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Split from '../../components/Split.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import MomentsSection from '../../components/MomentsSection.astro'

const serveMoments = [
  '587873749_18187772710338056_4306907528259398035_n.jpg',
  '624779024_18194108401338056_4396479470413009307_n.jpg',
  '587801958_18187772770338056_8255242398512079168_n.jpg',
]
---

<BaseLayout
  title="Serving Locally | Pine Lake Covenant Church"
  description="How Pine Lake shows up in the local community — partnering with the Issaquah Food & Clothing Bank, Bright Bridge, Echo Glen, and Young Life across Sammamish and Issaquah."
>
  <div class="canvas">
    <Split
      class="to-full"
      filename="715550230_18207937264338056_8366812198487572303_n.jpg"
      tone="sand"
      reverse
      eyebrow="In the community"
    >
      <h1 class="display">Serving Locally</h1>
      <p class="subhead">Showing up across Sammamish and Issaquah</p>
      <p class="lede">
        Being a good neighbor doesn’t stop at our doors. Pine Lake people show up across the area — not by starting our
        own programs, but by coming alongside trusted local organizations already doing good work.
      </p>
    </Split>

    <section class="section">
      <SectionHeader eyebrow="Local partners" heading="Organizations we partner with" />
      <p class="measure">
        We bring time, relationships, and practical help to a handful of partners we know and trust.
      </p>

      <div class="card-grid">
        <div class="card">
          <h3>
            <a href="https://issaquahfoodbank.org" target="_blank" rel="noopener">Issaquah Food &amp; Clothing Bank</a>
          </h3>
          <p>Stocking shelves and serving neighbors facing food insecurity across the Issaquah area.</p>
        </div>

        <div class="card">
          <h3><a href="https://brightbridgefoundation.org" target="_blank" rel="noopener">Bright Bridge</a></h3>
          <p>Coming alongside neighbors in a sudden financial crisis with emergency, practical support.</p>
        </div>

        <div class="card">
          <h3><a href="https://www.echoglen.org" target="_blank" rel="noopener">Echo Glen</a></h3>
          <p>
            Showing up for young people at the Echo Glen Children’s Center nearby — through ongoing encouragement and
            the handmade cards and gifts our church sends in.
          </p>
        </div>

        <div class="card">
          <h3><a href="https://capernaum.younglife.org" target="_blank" rel="noopener">Young Life</a></h3>
          <p>
            Coming alongside local middle and high schoolers, including Young Life Capernaum for students with
            disabilities.
          </p>
        </div>
      </div>
    </section>

    <MomentsSection heading={null} photos={serveMoments} sectionClass="to-wide" />

    <section class="section">
      <h2>Want to join in?</h2>
      <p class="measure">
        Most people start by showing up once, alongside someone who’s already involved. To find a good first step, email
        <a href="mailto:office@plcc.org">office@plcc.org</a> or call <a href="tel:+14253928636">(425) 392-8636</a>, and
        we’ll point you toward what’s coming up.
      </p>
    </section>
  </div>
</BaseLayout>

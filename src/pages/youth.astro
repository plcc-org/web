---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import MomentsSection from '../components/MomentsSection.astro'
import Photo from '../components/Photo.astro'
import YouthMoments from '../components/YouthMoments.astro'
import EventRow from '../components/EventRow.astro'
import { getCollection } from 'astro:content'
import { getUpcomingEvents } from '../lib/events/provider'
import { withBase } from '../lib/url'

const youthPhotos = [
  '515010876_1159769626191025_3703366804227887968_n.jpg',
  '649105057_18197705947338056_7727010854774354017_n.jpg',
  '650251601_18198219286338056_7378060351620760269_n.jpg',
  '587395483_18187772734338056_5738413555925055591_n.jpg',
  '715970017_18207937117338056_1177766278064408406_n.jpg',
  '650398531_18198219304338056_7874541032610820038_n.jpg',
]

const moments = (await getCollection('youthMoments')).sort((a, b) => a.data.order - b.data.order).map((m) => m.data)

// The next few dated Youth events from the live feed (Church Center in prod,
// curated fallback). Big annual moments live in `moments` above, not here.
const youthEvents = (await getUpcomingEvents()).filter((e) => e.category === 'Youth').slice(0, 4)
---

<BaseLayout
  title="Youth | Pine Lake Covenant Church"
  description="Pine Lake Youth: a place for 6th–12th graders to find Jesus together, connect, and serve."
>
  <div class="canvas">
    <Split
      class="to-full"
      filename="657972950_18200889988338056_8294978016122872582_n.jpg"
      tone="sand"
      reverse
      eyebrow="Middle & high school · 6th–12th grade"
    >
      <Photo
        filename="PineLakeYouth_logo_web.png"
        alt="Pine Lake Youth"
        class="youth__logo"
        loading="eager"
        fetchpriority="high"
        widths={[340, 680]}
        sizes="(max-width: 600px) 70vw, 340px"
      />
      <p class="subhead">A place for students to find &amp; follow Jesus together</p>
      <p class="lede">
        Our hope is that Pine Lake Youth would be a place where you can be yourself, belong to something bigger, and
        become part of bringing heaven to earth.
      </p>
      <p>
        <a class="btn btn--ghost" href="https://www.instagram.com/pinelakeyouth/" target="_blank" rel="noopener">
          Follow @pinelakeyouth
        </a>
      </p>
    </Split>

    <section class="section youth-quick">
      <div class="card-grid">
        <div class="card">
          <h2>Tuesday nights</h2>
          <p>
            <strong>6:00–8:00pm</strong><br />
            Dinner at 6pm, then connection time, worship, teaching, and small groups (middle school and high school).
          </p>
        </div>

        <div class="card">
          <h2>Sunday worship</h2>
          <p>
            <strong>10:00am</strong><br />
            Students sit together in the front three rows and are part of the whole church family.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-callout">
      <h2>What a Tuesday night feels like</h2>
      <p>Tuesday nights are built to feel welcoming and real for both middle school and high school students.</p>

      <ul>
        <li>Dinner at 6:00pm to start the night together</li>
        <li>Connection time and worship that is easy to step into</li>
        <li>Biblically grounded teaching with practical application</li>
        <li>Age-specific small groups where students can be known</li>
      </ul>
    </section>

    <MomentsSection
      heading="Moments from Pine Lake Youth"
      eyebrow="Life together"
      photos={youthPhotos.slice(0, 3)}
      sectionClass="to-wide"
    />

    <YouthMoments moments={moments} />

    {
      youthEvents.length > 0 && (
        <section class="section youth-upcoming">
          <div class="youth-upcoming__head">
            <h2 class="youth-upcoming__heading">Coming up</h2>
            <a href={withBase('whats-happening/youth/')}>All youth events →</a>
          </div>
          <div class="event-list">
            {youthEvents.map((e) => (
              <EventRow event={e} />
            ))}
          </div>
        </section>
      )
    }

    <MomentsSection heading={null} photos={youthPhotos.slice(3, 6)} sectionClass="to-wide" />
  </div>
</BaseLayout>

<style>
  /* On a <Photo>-rendered <img>, so must be global. */
  :global(.youth__logo) {
    display: block;
    width: clamp(13.75rem, 50vw, 21.25rem);
    height: auto;
    object-fit: contain;
    margin: 0 0 0.75rem;
  }

  .youth-upcoming__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: var(--space-md);
  }

  .youth-upcoming__heading {
    margin: 0;
  }
</style>

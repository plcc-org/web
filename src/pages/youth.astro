---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import MomentsSection from '../components/MomentsSection.astro'
import Photo from '../components/Photo.astro'
import { imageByFilename } from '../data/homePageImages'

const base = import.meta.env.BASE_URL

const youthMomentsItems = [
  {
    image: imageByFilename('515010876_1159769626191025_3703366804227887968_n.jpg'),
    fallbackAlt: 'Students praying together at Pine Lake Youth',
  },
  {
    image: imageByFilename('649105057_18197705947338056_7727010854774354017_n.jpg'),
    fallbackAlt: 'A student leading worship at Pine Lake Youth',
  },
  {
    image: imageByFilename('650251601_18198219286338056_7378060351620760269_n.jpg'),
    fallbackAlt: 'Students gathered together at Pine Lake Youth',
  },
]

const youthMomentsBottomItems = [
  {
    image: imageByFilename('515954979_1162096809291640_4380900858754798587_n.jpg'),
    fallbackAlt: 'Students together on a weekend retreat',
  },
  {
    image: imageByFilename('715970017_18207937117338056_1177766278064408406_n.jpg'),
    fallbackAlt: 'Students leading from the stage at Pine Lake Youth',
  },
  {
    image: imageByFilename('650398531_18198219304338056_7874541032610820038_n.jpg'),
    fallbackAlt: 'Students gathered for food after a youth celebration',
  },
]
---

<BaseLayout
  title="Youth | Pine Lake Covenant Church"
  description="Pine Lake Youth: a place for 6th–12th graders to find Jesus together, connect, and serve."
>
  <div class="canvas">
    <Split
      class="to-full"
      filename="587395483_18187772734338056_5738413555925055591_n.jpg"
      alt="A group of students together at Pine Lake Youth"
      tone="sand"
      reverse
      eyebrow="Middle & high school"
    >
      <Photo
        filename="PineLakeYouth_logo_web.png"
        alt="Pine Lake Youth"
        class="youth__logo"
        loading="eager"
        fetchpriority="high"
        widths={[340, 680]}
        sizes="(max-width: 600px) 70vw, 340px"
      />
      <p class="subhead">A place for students to find &amp; follow Jesus together</p>
      <p class="lede">
        Our hope is that Pine Lake Youth would be a place where you can be yourself, belong to something bigger, and
        become part of bringing heaven to earth.
      </p>
    </Split>

    <section class="section youth-quick">
      <div class="card-grid">
        <div class="card">
          <h2>Tuesday nights</h2>
          <p>
            <strong>6:00–8:00pm</strong><br />
            Dinner at 6pm, then connection time, worship, teaching, and small groups (middle school and high school).
          </p>
        </div>

        <div class="card">
          <h2>Sunday worship</h2>
          <p>
            <strong>10:00am</strong><br />
            Students sit together in the front three rows and are part of the whole church family.
          </p>
        </div>

        <div class="card">
          <h2>Who it’s for</h2>
          <p>
            <strong>6th–12th grade</strong><br />
            Middle school and high school students. Bring a friend. Come as you are.
          </p>
        </div>
      </div>
    </section>

    <MomentsSection
      heading="Moments from Pine Lake Youth"
      eyebrow="Life together"
      items={youthMomentsItems}
      sectionClass="to-wide"
    />

    <section class="section section-callout">
      <h2>What a Tuesday night feels like</h2>
      <p>Tuesday nights are built to feel welcoming and real for both middle school and high school students.</p>

      <ul>
        <li>Dinner at 6:00pm to start the night together</li>
        <li>Connection time and worship that is easy to step into</li>
        <li>Biblically grounded teaching with practical application</li>
        <li>Age-specific small groups where students can be known</li>
      </ul>
    </section>

    <section class="section youth-connect">
      <h2>Want to get connected?</h2>
      <p class="measure">
        New to youth group? You will not be the only one. Whether church feels familiar or brand new, this is a great
        place to begin.
      </p>

      <p class="youth-connect__links">
        <a href="https://www.instagram.com/pinelakeyouth/" target="_blank" rel="noopener">Instagram</a>
        <a href="mailto:office@plcc.org">Email</a>
        <a href={`${base}whats-happening/`}>Current schedule</a>
      </p>
    </section>

    <section class="section">
      <p class="eyebrow">Through the year</p>
      <h2>Highlights through the year</h2>
      <p class="measure">
        Alongside our weekly rhythm, we run a few annual experiences that help students grow in faith and friendship.
      </p>

      <div class="card-grid">
        <div class="card">
          <h3>Confirmation</h3>
          <p>
            A 6-month track for students in 8th grade and up to dig into following Jesus — mentor relationships, monthly
            teaching, and Confirmation Sunday in early June.
          </p>
        </div>

        <div class="card">
          <h3>Campbell Farm</h3>
          <p>
            A 3-day middle school summer trip to Wapato, WA, with teaching, cross-cultural learning, and a lot of fun
            together.
          </p>
        </div>

        <div class="card">
          <h3>Retreats</h3>
          <p>
            Weekend retreats each year focused on fun, worship, teaching, and deeper friendships, both with Pine Lake
            and partner churches.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="eyebrow">Faith that moves outward</p>
      <h2>Service &amp; missions</h2>
      <p class="measure">
        We want students to see faith move outward through practical service, both locally and globally.
      </p>

      <ul>
        <li><strong>Global 6K for Water</strong> — a whole-family walk each spring that helps provide clean water.</li>
        <li>
          <strong>Capernaum Talent Show</strong> — an annual event with Young Life Capernaum for students with special needs
          and their families.
        </li>
        <li>
          <strong>Community Meal Packaging</strong> — typically in early December, helping package meals for kids in Sierra
          Leone.
        </li>
        <li>
          <strong>Unite</strong> — a regional high school gathering held every other summer (next planned: Summer 2027).
        </li>
      </ul>

      <p>
        <a href={`${base}whats-happening/`}>See what’s coming up →</a>
      </p>
    </section>

    <MomentsSection heading={null} items={youthMomentsBottomItems} sectionClass="to-wide" />
  </div>
</BaseLayout>

<style>
  /* On a <Photo>-rendered <img>, so must be global. */
  :global(.youth__logo) {
    display: block;
    width: clamp(13.75rem, 50vw, 21.25rem);
    height: auto;
    object-fit: contain;
    margin: 0 0 0.75rem;
  }

  .youth-connect__links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSundayServices } from '../lib/messages'

const { latest: latestService, archive: archiveServices } = await getSundayServices()
---

<BaseLayout title="Messages | Pine Lake Covenant Church">
  <article class="page archive-page">
    <header class="page__header archive-header">
      <p class="archive-header__eyebrow">Sunday Messages</p>
      <h1>Worship With Us Anytime</h1>

      <p class="page__lede">
        Catch up on recent Sunday services or revisit a message that encouraged you. Start with the latest service
        below, then browse the archive.
      </p>
    </header>

    <section class="service-hero" aria-labelledby="latest-service-heading">
      <div class="service-hero__media">
        <iframe
          src={latestService.embedUrl}
          title={latestService.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>

      <div class="service-hero__content">
        <p class="service-hero__tag">Most Recent Service</p>
        <h2 id="latest-service-heading">{latestService.title}</h2>
        <p class="service-hero__date">{latestService.dateLabel}</p>

        <p>Join in worship, prayer, and Scripture from our latest Sunday gathering.</p>

        <div class="service-hero__actions">
          <a href={latestService.watchUrl} target="_blank" rel="noopener">Watch on YouTube</a>
          <a href="https://www.youtube.com/@PineLkCovChurch/streams" target="_blank" rel="noopener">
            View Full Streams Archive
          </a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="archive-heading">
      <div class="section__header">
        <h2 id="archive-heading">Service Archive</h2>
        <p>Recent Sunday services in reverse chronological order.</p>
      </div>

      <ul class="service-grid" role="list">
        {
          archiveServices.map((service) => (
            <li>
              <article class="service-card">
                <a class="service-card__image-link" href={service.watchUrl} target="_blank" rel="noopener">
                  <img src={service.thumbnailUrl} alt={service.title} loading="lazy" width="480" height="360" />
                </a>
                <div class="service-card__body">
                  <p class="service-card__date">{service.dateLabel}</p>
                  <h3>{service.title}</h3>
                  <a href={service.watchUrl} target="_blank" rel="noopener">
                    Watch Service
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .archive-page {
    --archive-bg: #fbf7f0;
    --archive-surface: #fffdf8;
    --archive-border: #dfd4c3;
    --archive-text: #2a2118;
    --archive-muted: #6f6255;
    --archive-accent: #b9622f;
    --archive-accent-soft: #f0d8c9;

    color: var(--archive-text);
  }

  .archive-header {
    margin-bottom: clamp(1.25rem, 2.8vw, 2rem);
  }

  .archive-header__eyebrow {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--archive-border);
    border-radius: 999px;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--archive-muted);
    background: var(--archive-surface);
  }

  .service-hero {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: 1.25rem;
    border: 1px solid var(--archive-border);
    background:
      radial-gradient(circle at 0% 100%, var(--archive-accent-soft), transparent 32%),
      linear-gradient(180deg, #fffefb, var(--archive-bg));
    box-shadow: 0 0.8rem 2rem rgb(42 33 24 / 0.08);
  }

  .service-hero__media {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: 1rem;
    overflow: hidden;
    background: #111;
  }

  .service-hero__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .service-hero__tag {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--archive-accent);
    font-weight: 700;
  }

  .service-hero h2 {
    margin: 0;
  }

  .service-hero__date {
    margin: 0.4rem 0 1rem;
    color: var(--archive-muted);
  }

  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .service-hero__actions a {
    display: inline-block;
    padding: 0.62rem 0.95rem;
    border-radius: 0.65rem;
    border: 1px solid var(--archive-border);
    text-decoration: none;
    font-weight: 600;
    color: var(--archive-text);
    background: var(--archive-surface);
  }

  .service-hero__actions a:first-child {
    color: #fff;
    background: var(--archive-accent);
    border-color: var(--archive-accent);
  }

  .section__header {
    margin-bottom: 1rem;
  }

  .section__header h2 {
    margin: 0;
  }

  .section__header p {
    margin: 0.35rem 0 0;
    color: var(--archive-muted);
  }

  .service-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
  }

  .service-card {
    height: 100%;
    border-radius: 0.95rem;
    overflow: hidden;
    border: 1px solid var(--archive-border);
    background: var(--archive-surface);
    box-shadow: 0 0.3rem 1rem rgb(42 33 24 / 0.06);
  }

  .service-card__image-link {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #111;
  }

  .service-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 160ms ease;
  }

  .service-card__image-link:hover img,
  .service-card__image-link:focus-visible img {
    transform: scale(1.04);
  }

  .service-card__body {
    padding: 0.8rem 0.85rem 0.95rem;
  }

  .service-card__date {
    margin: 0;
    font-size: 0.84rem;
    color: var(--archive-muted);
  }

  .service-card h3 {
    margin: 0.5rem 0 0.6rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .service-card__body a {
    font-weight: 600;
  }

  @media (min-width: 880px) {
    .service-hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>

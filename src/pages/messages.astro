---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'
import { church } from '../config/church'
import { getSundayServices } from '../lib/messages'

const { latest: latestService, archive: archiveServices } = await getSundayServices()
---

<BaseLayout
  title="Messages"
  description="Watch recent Sunday services from Pine Lake Covenant Church in Sammamish — teaching, music, and prayer, whenever suits you."
>
  <div class="canvas archive-page">
    <PageIntro eyebrow="Sunday Messages" title="Worship with us anytime" class="archive-header">
      <p class="lede">
        Catch up on recent Sunday services or revisit a message that encouraged you. Start with the latest service
        below, then browse the archive.
      </p>
    </PageIntro>

    <section class="section service-hero" aria-labelledby="latest-service-heading">
      <div class="service-hero__media">
        <iframe
          src={latestService.embedUrl}
          title={latestService.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>

      <div class="service-hero__content">
        <p class="service-hero__tag">Most Recent Service</p>
        <h2 id="latest-service-heading">{latestService.title}</h2>
        <p class="service-hero__date">{latestService.dateLabel}</p>

        <p>Join in worship, prayer, and Scripture from our latest Sunday gathering.</p>

        <div class="service-hero__actions">
          <a class="btn" href={latestService.watchUrl} target="_blank" rel="noopener">Watch on YouTube</a>
          <a class="btn btn--ghost" href={`${church.social.youtube}/streams`} target="_blank" rel="noopener">
            All services on YouTube
          </a>
          <a class="btn btn--ghost" href={church.social.podcast} target="_blank" rel="noopener">
            Listen on Apple Podcasts
          </a>
        </div>
      </div>
    </section>

    <section class="section to-wide" aria-labelledby="archive-heading">
      <div class="archive-section__header">
        <p class="eyebrow">Archive</p>
        <h2 id="archive-heading">Service archive</h2>
        <p>Recent Sunday services in reverse chronological order.</p>
      </div>

      <ul class="service-grid" role="list">
        {
          archiveServices.map((service) => (
            <li>
              <article class="service-card">
                {/* The thumbnail is decorative — it repeats the <h3> below it.
                    Deliberately inert: linking it as well would give every card
                    two links to the same URL, so keyboard and screen-reader
                    users would hit each service twice. The link below carries
                    the accessible name. */}
                <span class="service-card__media">
                  <img
                    src={service.thumbnailUrl}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    width="480"
                    height="360"
                  />
                </span>
                <div class="service-card__body">
                  <p class="service-card__date">{service.dateLabel}</p>
                  <h3>{service.title}</h3>
                  <a href={service.watchUrl} target="_blank" rel="noopener">
                    Watch <span class="visually-hidden">{service.title}</span> on YouTube
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSundayServices } from '../lib/messages'

const { latest: latestService, archive: archiveServices } = await getSundayServices()
---

<BaseLayout
  title="Messages | Pine Lake Covenant Church"
  description="Watch recent Sunday services from Pine Lake Covenant Church in Sammamish — teaching, music, and prayer, whenever suits you."
>
  <div class="canvas archive-page">
    <header class="section page-intro archive-header">
      <p class="eyebrow">Sunday Messages</p>
      <h1 class="display">Worship with us anytime</h1>

      <p class="lede">
        Catch up on recent Sunday services or revisit a message that encouraged you. Start with the latest service
        below, then browse the archive.
      </p>
    </header>

    <section class="section service-hero" aria-labelledby="latest-service-heading">
      <div class="service-hero__media">
        <iframe
          src={latestService.embedUrl}
          title={latestService.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>

      <div class="service-hero__content">
        <p class="service-hero__tag">Most Recent Service</p>
        <h2 id="latest-service-heading">{latestService.title}</h2>
        <p class="service-hero__date">{latestService.dateLabel}</p>

        <p>Join in worship, prayer, and Scripture from our latest Sunday gathering.</p>

        <div class="service-hero__actions">
          <a class="btn" href={latestService.watchUrl} target="_blank" rel="noopener">Watch on YouTube</a>
          <a
            class="btn btn--ghost"
            href="https://www.youtube.com/@PineLkCovChurch/streams"
            target="_blank"
            rel="noopener"
          >
            All services on YouTube
          </a>
        </div>
      </div>
    </section>

    <section class="section to-wide" aria-labelledby="archive-heading">
      <div class="section__header">
        <p class="eyebrow">Archive</p>
        <h2 id="archive-heading">Service archive</h2>
        <p>Recent Sunday services in reverse chronological order.</p>
      </div>

      <ul class="service-grid" role="list">
        {
          archiveServices.map((service) => (
            <li>
              <article class="service-card">
                {/* The thumbnail is decorative: it repeats the <h3> below it, and
                    it linked to the same URL as "Watch Service", so keyboard and
                    screen-reader users hit every service twice. It's now inert,
                    with the single link below carrying the accessible name. */}
                <span class="service-card__media">
                  <img
                    src={service.thumbnailUrl}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    width="480"
                    height="360"
                  />
                </span>
                <div class="service-card__body">
                  <p class="service-card__date">{service.dateLabel}</p>
                  <h3>{service.title}</h3>
                  <a href={service.watchUrl} target="_blank" rel="noopener">
                    Watch <span class="visually-hidden">{service.title}</span> on YouTube
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .archive-page {
    --archive-surface: var(--color-paper);
    --archive-border: var(--color-mist);
    --archive-muted: var(--color-clay);

    color: var(--color-forest);
  }

  .service-hero {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--archive-border);
    background: var(--surface-gradient-soft);
    box-shadow: var(--shadow-md);
  }

  .service-hero__media {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: var(--radius-soft);
    overflow: hidden;
    background: #111;
  }

  .service-hero__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .service-hero__tag {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-moss-2);
    font-weight: 600;
  }

  .service-hero h2 {
    margin: 0;
  }

  .service-hero__date {
    margin: 0.4rem 0 1rem;
    color: var(--archive-muted);
  }

  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .section__header {
    margin-bottom: 1rem;
  }

  .section__header h2 {
    margin: 0;
  }

  .section__header p {
    margin: 0.35rem 0 0;
    color: var(--archive-muted);
  }

  .service-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
  }

  /* Surface + lift from the shared card recipe; the clip keeps the thumbnail
     inside the card's radius. */
  .service-card {
    height: 100%;
    overflow: hidden;
  }

  .service-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #111;
  }

  .service-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) ease;
  }

  /* Driven from the card, not the thumbnail: the thumbnail is no longer a link,
     so it can't take focus, and the zoom should answer the card's one link. */
  .service-card:hover img,
  .service-card:focus-within img {
    transform: scale(1.04);
  }

  .service-card__body {
    padding: 0.8rem 0.85rem 0.95rem;
  }

  .service-card__date {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--archive-muted);
  }

  .service-card h3 {
    margin: 0.5rem 0 0.6rem;
    font-size: var(--text-base);
    line-height: 1.3;
  }

  .service-card__body a {
    font-weight: 600;
  }

  @media (min-width: 880px) {
    .service-hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import { getCollection } from 'astro:content'
import { featuredPhotos } from '../lib/gallery'
import { withBase } from '../lib/url'

const imNewLinks = (await getCollection('startHereLinks'))
  .filter((l) => l.data.group === 'im-new')
  .sort((a, b) => a.data.order - b.data.order)
  .map((l) => l.data)

const imNewMoments = await featuredPhotos('im-new', 3)
---

<BaseLayout title="I’m New | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="688117169_18204342136338056_7738717935775703001_n.jpg"
      alt="Friends catching up in the foyer near the Pine Lake Kids check-in"
      tone="sand"
      reverse
      eyebrow="Welcome"
    >
      <h1 class="display">I’m New</h1>
      <p class="lede">
        Visiting a new church can feel unfamiliar — especially if you haven’t been in a while, or aren’t quite sure what
        you’re looking for. Whether you’re just curious or thinking about visiting for the first time, we’re glad you’re
        here.
      </p>
      <p><a class="btn" href={withBase('plan-a-visit/')}>Plan a Visit</a></p>
    </Split>

    <LinkCardSection heading="More about us" links={imNewLinks} />

    <Split
      class="to-full"
      filename="496814139_18165842923338056_8245433015909218005_n.jpg"
      alt="The congregation worshipping together under the sanctuary’s timber-framed ceiling"
      tone="paper"
      eyebrow="No pressure"
      heading="What to expect here"
    >
      <p>
        You won’t be asked to introduce yourself, explain what you believe, or commit to anything. Some people who come
        to Pine Lake have deep faith; others are exploring, returning after time away, or connected through family or
        community.
      </p>
      <p>You’re welcome to participate at whatever pace feels right to you.</p>
    </Split>

    <MomentsSection
      heading="Moments from Pine Lake"
      eyebrow="Life together"
      items={imNewMoments}
      sectionClass="to-wide"
    />
  </div>
</BaseLayout>

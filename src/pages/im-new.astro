---
import BaseLayout from '../layouts/BaseLayout.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import { imNewStartHereLinks } from '../data/startHereLinks'
import { homePageImages } from '../data/homePageImages'

const imageByFilename = (filename: string) => homePageImages.find((image) => image.filename === filename)

const imNewMomentsItems = [
  {
    image: imageByFilename('474748731_1030392515795404_2521947271930024728_n.jpg'),
    fallbackAlt: 'People connecting together in community',
  },
  {
    image: imageByFilename('527613266_18174174280338056_1626054179180271796_n.jpg'),
    fallbackAlt: 'A prayer moment during a church gathering',
  },
  {
    image: imageByFilename('551447661_18178844206338056_8896943485236580927_n.jpg'),
    fallbackAlt: 'A candid community moment at Pine Lake',
  },
]
---

<BaseLayout title="I’m New | Pine Lake Covenant Church">
  <article class="page page--wide">
    <header class="page__header prose-measure">
      <h1>I’m New</h1>
      <p class="page__lede text-body-large">
        Visiting a new church can feel unfamiliar — especially if you haven’t been to church in a while, or aren’t quite
        sure what you’re looking for. Whether you’re just curious or thinking about visiting for the first time, we’re
        glad you’re here.
      </p>
    </header>

    <LinkCardSection links={imNewStartHereLinks} />

    <section class="section section-callout">
      <h2>What to expect here</h2>

      <p>
        You won’t be asked to introduce yourself, explain what you believe, or commit to anything. Some people who come
        to Pine Lake have deep faith, others are exploring, returning after time away, or connected through family or
        community.
      </p>

      <p>You’re welcome to participate at whatever pace feels right to you.</p>
    </section>
  </article>

  <MomentsSection heading="Moments from Pine Lake" items={imNewMomentsItems} sectionClass="section" />
</BaseLayout>

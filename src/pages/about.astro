---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import type { LinkCardItem } from '../data/startHereLinks'
import { imageByFilename } from '../data/homePageImages'

const aboutLinks: LinkCardItem[] = [
  {
    href: 'about/ethos/',
    title: 'Our Ethos',
    meta: 'The heart and posture we hope shapes our life together.',
  },
  {
    href: 'about/beliefs/',
    title: 'What We Believe',
    meta: 'Core convictions that guide our teaching and life together.',
  },
  {
    href: 'about/leadership/',
    title: 'Leadership',
    meta: 'Meet the pastors and leaders serving our community.',
  },
  {
    href: 'about/pastors-letter/',
    title: "Pastor's Letter",
    meta: 'A personal welcome and vision for where we are headed.',
  },
  {
    href: 'about/covenant/',
    title: 'The Evangelical Covenant Church',
    meta: 'How Pine Lake relates to the wider Covenant family of churches.',
  },
]

const aboutMomentsItems = [
  {
    image: imageByFilename('496764399_18166032214338056_8744828942491316308_n.jpg'),
    fallbackAlt: 'People gathered together after a Sunday service',
  },
  {
    image: imageByFilename('475891141_1037080631793259_4238958896521856436_n.jpg'),
    fallbackAlt: 'People worshiping together in a Sunday gathering',
  },
  {
    image: imageByFilename('624779024_18194108401338056_4396479470413009307_n.jpg'),
    fallbackAlt: 'A warm community moment at Pine Lake Covenant Church',
  },
]
---

<BaseLayout title="About | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="688099949_18204342151338056_3539234897453255183_n.jpg"
      alt="The worship team leading music on a Sunday morning"
      tone="sand"
      reverse
      eyebrow="About"
    >
      <h1 class="display">About Pine Lake</h1>
      <p class="lede">
        Pine Lake is a church in Sammamish centered on Jesus, rooted in Scripture, and committed to being a place where
        people can belong, heal, and grow.
      </p>
    </Split>

    <LinkCardSection heading="Explore Pine Lake" links={aboutLinks} />

    <MomentsSection
      heading="A few moments from our community"
      eyebrow="Life together"
      items={aboutMomentsItems}
      sectionClass="to-wide"
    />
  </div>
</BaseLayout>

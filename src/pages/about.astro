---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import MomentsSection from '../components/MomentsSection.astro'
import type { LinkCardItem } from '../components/LinkCardSection.astro'

const aboutLinks: LinkCardItem[] = [
  {
    href: 'about/what-were-about/',
    title: 'What We’re About',
    meta: 'What shapes our life together, in plain language.',
  },
  {
    href: 'about/beliefs/',
    title: 'What We Believe',
    meta: 'Our core convictions, shared with the wider Covenant church.',
  },
  {
    href: 'about/leadership/',
    title: 'Leadership',
    meta: 'Meet the pastors and leaders serving our community.',
  },
  {
    href: 'about/pastors-letter/',
    title: "Pastor's Letter",
    meta: 'A personal welcome and vision for where we are headed.',
  },
  {
    href: 'about/covenant/',
    title: 'The Evangelical Covenant Church',
    meta: 'How Pine Lake relates to the wider Covenant family of churches.',
  },
]

const aboutMoments = [
  '496764399_18166032214338056_8744828942491316308_n.jpg',
  '475891141_1037080631793259_4238958896521856436_n.jpg',
  '624779024_18194108401338056_4396479470413009307_n.jpg',
]
---

<BaseLayout title="About | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="688099949_18204342151338056_3539234897453255183_n.jpg"
      tone="sand"
      reverse
      eyebrow="About"
    >
      <h1 class="display">About Pine Lake</h1>
      <p class="lede">
        Pine Lake is a church in Sammamish centered on Jesus, rooted in Scripture, and committed to being a place where
        people can belong, heal, and grow.
      </p>
    </Split>

    <LinkCardSection heading="Explore Pine Lake" links={aboutLinks} />

    <MomentsSection
      heading="A few moments from our community"
      eyebrow="Life together"
      photos={aboutMoments}
      sectionClass="to-wide"
    />
  </div>
</BaseLayout>

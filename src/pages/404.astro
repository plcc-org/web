---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'
import Band from '../components/Band.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import { getCollection } from 'astro:content'

// The 404 reuses the home page's "start here" cards: whatever we'd point a
// first-time visitor at is also the right list for someone who landed nowhere.
const strayLinks = (await getCollection('startHereLinks'))
  .filter((l) => l.data.group === 'home')
  .sort((a, b) => a.data.order - b.data.order)
  .map((l) => ({ href: l.data.href, title: l.data.title, meta: l.data.meta }))
---

<BaseLayout
  title="Page Not Found | Pine Lake Covenant Church"
  description="The page you are looking for could not be found."
  noindex={true}
>
  <div class="canvas">
    <PageIntro
      eyebrow="404"
      title="This page has wandered off"
      subhead="Ninety-nine of our pages are right where they should be. This is the other one."
    />

    <Band tone="sand" centered>
      <blockquote class="verse">
        <p>“I have strayed like a lost sheep. Seek your servant.”</p>
        <footer>Psalm 119:176</footer>
      </blockquote>
    </Band>

    <LinkCardSection heading="Try one of these" links={strayLinks} />
  </div>
</BaseLayout>

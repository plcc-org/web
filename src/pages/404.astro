---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/url'
---

<BaseLayout
  title="Page Not Found | Pine Lake Covenant Church"
  description="The page you are looking for could not be found."
  noindex={true}
>
  <article class="page">
    <header class="page__header">
      <h1>Page not found</h1>
      <p class="lede">We could not find that page. It may have moved or been renamed.</p>
    </header>

    <section class="section">
      <p>
        Try <a href={withBase()}>Home</a> or <a href={withBase('new/')}>I’m New</a>.
      </p>
    </section>
  </article>
</BaseLayout>

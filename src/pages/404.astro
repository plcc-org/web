---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'
import Band from '../components/Band.astro'

// Deliberately just a heading and the verse. The footer site map is the way
// out, so a list of suggested pages here would only blunt the joke.
//
// The script is for the CMS. Visual editing opens a page at its real address, and
// a page saved since the last deploy — or any draft — has no HTML there yet. Inside
// the admin iframe, retry the same address under /tina-preview/, which renders it
// live from TinaCloud. Checking the parent is the admin (same origin, so readable)
// keeps it from firing for anyone else; skipping the prefix stops a page TinaCloud
// doesn't have either from looping.
const base = import.meta.env.BASE_URL
---

<script is:inline define:vars={{ base }}>
  try {
    const path = location.pathname
    const inAdmin = window.self !== window.top && window.top.location.pathname.startsWith(`${base}admin`)
    if (inAdmin && path.startsWith(base) && !path.startsWith(`${base}tina-preview/`)) {
      location.replace(`${base}tina-preview/${path.slice(base.length)}${location.search}`)
    }
  } catch {
    // A cross-origin parent throws on location — not the admin, so nothing to do.
  }
</script>

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found." noindex={true}>
  <div class="canvas">
    <PageIntro title="Page not found" />

    <Band tone="sand" centered flush>
      <blockquote class="verse">
        <p>And a man found him wandering in the fields. And the man asked him, “What are you seeking?”</p>
        <footer>Genesis 37:15</footer>
      </blockquote>
    </Band>
  </div>
</BaseLayout>

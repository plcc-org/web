---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Next Steps | Pine Lake Covenant Church">
  <article class="page">
    <header class="page__header">
      <h1>Next Steps</h1>
      <p class="page__lede">
        If you are wondering what comes after a first visit, this is a good place to start. You do not need to do
        everything at once. Pick one step that fits your pace.
      </p>
      <figure class="media">
        <div class="media__frame ratio-16x9">
          <span class="media__label">Hero photo placeholder (next steps)</span>
        </div>
      </figure>
    </header>

    <section class="section">
      <div class="card-grid">
        <a href="https://plcc.churchcenter.com/groups" class="card">
          <h3>Find Your People</h3>
          <p>Explore groups for different life stages. You are welcome to browse first and join when ready.</p>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
        <a href="https://plcc.churchcenter.com/registrations" class="card">
          <h3>Upcoming Signups</h3>
          <p>See events and registrations in one place. Start with one thing that feels manageable.</p>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
        <a href={`${import.meta.env.BASE_URL}serve/`} class="card">
          <h3>Serve With Others</h3>
          <p>Serving is a practical way to meet people and contribute. We can help you find a good fit.</p>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
        <a href={`${import.meta.env.BASE_URL}contact/`} class="card">
          <h3>Talk With Someone</h3>
          <p>Have questions or want a personal connection point? Reach out and we will follow up.</p>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

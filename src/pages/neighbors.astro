---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import SectionHeader from '../components/SectionHeader.astro'
import DoorCard from '../components/DoorCard.astro'
import MomentsSection from '../components/MomentsSection.astro'
import { getCollection } from 'astro:content'

const doors = (await getCollection('neighborDoors')).sort((a, b) => a.data.order - b.data.order)

const neighborsMoments = [
  '587497434_18187772761338056_6575013280016458585_n.jpg',
  '551447661_18178844206338056_8896943485236580927_n.jpg',
  '624779024_18194108401338056_4396479470413009307_n.jpg',
]
---

<BaseLayout title="For Our Neighbors | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="551096105_18178844185338056_8945047004848009463_n.jpg"
      tone="sand"
      reverse
      eyebrow="For Our Neighbors"
    >
      <h1 class="display">For Our Neighbors</h1>
      <p class="subhead">Serving Sammamish, Issaquah, and the surrounding communities</p>
      <p class="lede">
        We want to be a genuinely good neighbor — investing in the people and places around us, not just gathering on
        Sundays. That looks like backing the local organizations already doing good work, opening our building as a
        shared resource, and showing up when life gets hard.
      </p>
    </Split>

    <section class="section">
      <SectionHeader eyebrow="Where to start" heading="Common starting points" />
      <p class="measure">People come through our doors for different reasons. Here are a few of the most common.</p>

      <div class="doors" aria-label="Ways to connect with Pine Lake">
        {doors.map((d) => <DoorCard {...d.data} />)}
      </div>
    </section>

    <MomentsSection
      heading="Out in the community"
      eyebrow="Where we live"
      photos={neighborsMoments}
      sectionClass="to-wide"
    />
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Split from '../../components/Split.astro'
import Band from '../../components/Band.astro'
import { withBase } from '../../lib/url'
---

<BaseLayout title="Weddings & Memorials | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="467977252_18149338267338056_1889842660921052110_n.jpg"
      tone="sand"
      reverse
      eyebrow="For Our Neighbors"
    >
      <h1 class="display">Weddings &amp; Memorials</h1>
      <p class="subhead">A place to celebrate, remember, and be supported by community.</p>
      <p class="lede">
        Our lives include seasons of great joy and great sorrow. In both, we need community — people to celebrate with
        us, and people to mourn with us. Pine Lake offers support in coordinating weddings and memorial services.
      </p>
    </Split>

    <Band tone="forest" class="verse-band">
      <blockquote class="verse">
        <p>“Rejoice with those who rejoice; mourn with those who mourn.”</p>
        <footer>Romans 12:15</footer>
      </blockquote>
    </Band>

    <Split
      class="to-full"
      filename="467727902_18149338249338056_7861795867212358283_n.jpg"
      tone="paper"
      eyebrow="Celebrate"
      heading="Weddings"
    >
      <p>
        Weddings are a significant moment of transition and commitment. Our Wedding Coordinator is available to support
        you through planning, rehearsal, and the wedding day, including:
      </p>
      <ul>
        <li>Verifying availability of wedding support staff and requested services</li>
        <li>Working with pastoral staff to help direct the rehearsal</li>
        <li>Being present at the wedding (and reception, if held at Pine Lake)</li>
        <li>Assisting the wedding party prior to the ceremony</li>
        <li>Helping oversee on-site details at the church</li>
      </ul>
      <p>
        To inquire about a wedding at Pine Lake, call <a href="tel:+14253928636">(425) 392-8636</a> or email
        <a href="mailto:office@plcc.org">office@plcc.org</a>.
      </p>
    </Split>

    <Split
      class="to-full"
      filename="plcc-prayer-candles.jpg"
      tone="sand"
      reverse
      eyebrow="Remember"
      heading="Memorials"
    >
      <p>
        When a loved one dies, there is a need to commemorate their life and memory — and to find hope and comfort in
        the midst of grief. Our Memorial Team provides support for memorial services held at Pine Lake.
      </p>
      <p>
        Our Memorial Coordinator can assist with coordinating the service, scheduling participants, and arranging an
        after-service reception when appropriate, working closely with pastoral staff to offer support and direction.
      </p>
      <p>
        For memorial service inquiries, call <a href="tel:+14253928636">(425) 392-8636</a> or email
        <a href="mailto:office@plcc.org">office@plcc.org</a>.
      </p>
    </Split>

    <section class="section">
      <h2>Not sure where to start?</h2>
      <p class="measure">
        If you have questions or aren’t sure what you need, just reach out — we’ll help you find the right next step.
      </p>
      <p><a href={withBase('contact/')}>Contact us →</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  /* `.band__inner` is rendered by <Band>, so it must be reached with :global() */
  :global(.verse-band .band__inner) {
    max-width: 48rem;
    text-align: center;
  }

  .verse {
    margin: 0;
  }

  .verse p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-2xl);
    line-height: 1.35;
    color: var(--color-white);
    text-wrap: balance;
  }

  .verse footer {
    margin-top: 1.1rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-sm);
    color: var(--color-on-dark-soft);
  }
</style>

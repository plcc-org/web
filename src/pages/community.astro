---
import BaseLayout from '../layouts/BaseLayout.astro'
import Photo from '../components/Photo.astro'
import { imageAlt, pickImageByAnyTag } from '../data/homePageImages'

const communityHeroImage = pickImageByAnyTag(['community', 'gathering', 'social'])
const lifeTogetherImage = pickImageByAnyTag(['community', 'social', 'gathering'], [communityHeroImage?.filename ?? ''])
const generosityImage = pickImageByAnyTag(['generosity', 'service'])
const careImage = pickImageByAnyTag(['care', 'prayer'])
---

<BaseLayout title="Community | Pine Lake Covenant Church">
  <article class="page">
    <header class="page__header">
      <h1>Community</h1>

      <p class="page__lede">
        Pine Lake is more than a Sunday gathering. This page is for people who are beginning to make Pine Lake home, and
        want to see what shared life looks like here.
      </p>
      <figure class="media">
        <div class="media__frame ratio-16x9">
          {
            communityHeroImage ? (
              <Photo
                filename={communityHeroImage.filename}
                alt={imageAlt(communityHeroImage, 'People connected in community at Pine Lake')}
                class="media__img media__img--cover"
                loading="eager"
                fetchpriority="high"
              />
            ) : null
          }
        </div>
      </figure>
    </header>

    <section class="section">
      <h2>Life together</h2>

      <p>
        Community at Pine Lake takes many forms — gathering in smaller groups, serving alongside others, and supporting
        one another through different seasons of life.
      </p>

      <div class="media__frame ratio-4x3">
        {
          lifeTogetherImage ? (
            <Photo
              filename={lifeTogetherImage.filename}
              alt={imageAlt(lifeTogetherImage, 'People sharing life together at Pine Lake')}
              class="media__img media__img--cover"
            />
          ) : null
        }
      </div>

      <ul>
        <li>
          <strong>Life Groups</strong><br />
          Small groups that meet regularly to build relationships, study Scripture, and grow together.
        </li>
        <li>
          <strong>Serve & Volunteer</strong><br />
          Opportunities to serve within the church and in the wider community.
        </li>
      </ul>
    </section>

    <section class="section">
      <h2>Practicing generosity</h2>

      <p>
        Giving is one way we respond to God’s generosity toward us. It supports the mission and shared life of Pine
        Lake, and helps us care for our community, both locally and globally.
      </p>

      <div class="media__frame ratio-4x3">
        {
          generosityImage ? (
            <Photo
              filename={generosityImage.filename}
              alt={imageAlt(generosityImage, 'People practicing generosity through shared ministry')}
              class="media__img media__img--cover"
            />
          ) : null
        }
      </div>

      <p>
        <a href="https://plcc.churchcenter.com/giving">Learn more about giving at Pine Lake</a>
      </p>
    </section>

    <section class="section">
      <h2>Care & support</h2>

      <p>
        When life is difficult, the church is here to offer prayer, care, and practical support. You don’t have to walk
        alone.
      </p>

      <div class="media__frame ratio-4x3">
        {
          careImage ? (
            <Photo
              filename={careImage.filename}
              alt={imageAlt(careImage, 'Prayer and care support at Pine Lake')}
              class="media__img media__img--cover"
            />
          ) : null
        }
      </div>
    </section>

    <section class="section">
      <h2>Getting started</h2>

      <p>
        If you are exploring Pine Lake for the first time,
        <a href={`${import.meta.env.BASE_URL}next-steps/`}>Next Steps</a>
        is usually the best place to begin.
      </p>
    </section>
  </article>
</BaseLayout>

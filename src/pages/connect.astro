---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Get Connected | Pine Lake Covenant Church">
  <article class="page">
    <header class="page__header">
      <h1>Get Connected</h1>
      <p class="page__lede">Groups, serving opportunities, and simple next steps.</p>
      <figure class="media">
        <div class="media__frame ratio-16x9">
          <span class="media__label">Hero photo placeholder (community)</span>
        </div>
      </figure>
    </header>
    <section class="section">
      <div class="card-grid">
        <a href="#" class="card">
          <h3>Groups</h3>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
          <p>Find community in a small group.</p>
        </a>
        <a href="#" class="card">
          <h3>Serving</h3>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
          <p>Make a difference on a team.</p>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

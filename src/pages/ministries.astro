---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Ministries | Pine Lake Covenant Church">
  <article class="page">
    <header class="page__header">
      <h1>Ministries</h1>
      <p class="page__lede">Ways to connect by life stage and community.</p>
      <figure class="media">
        <div class="media__frame ratio-16x9">
          <span class="media__label">Hero photo placeholder (ministry)</span>
        </div>
      </figure>
    </header>

    <section class="section">
      <div class="card-grid">
        <a href={`${import.meta.env.BASE_URL}families/`} class="card">
          <h3>Kids & Families</h3>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
        <a href={`${import.meta.env.BASE_URL}ministries/adults/`} class="card">
          <h3>Adults</h3>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
        <a href={`${import.meta.env.BASE_URL}ministries/care/`} class="card">
          <h3>Care & Support</h3>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
        <a href={`${import.meta.env.BASE_URL}ministries/outreach/`} class="card">
          <h3>Outreach</h3>
          <div class="media__frame ratio-16x9">
            <span class="media__label">Photo placeholder</span>
          </div>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

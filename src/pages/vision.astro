---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import AccentList from '../components/AccentList.astro'
import LinkCardSection from '../components/LinkCardSection.astro'
import type { LinkCardItem } from '../components/LinkCardSection.astro'

const pillars = [
  {
    title: 'Be with Jesus',
    desc: 'Staying close to him — through prayer, worship, study, and Sabbath.',
  },
  {
    title: 'Become like Jesus',
    desc: 'Letting his character reshape ours over a lifetime.',
  },
  {
    title: 'Do what Jesus did',
    desc: 'Loving and serving the people around us, and our wider community.',
  },
]

const focus = [
  {
    title: 'A shared vision',
    body: 'This isn’t a vision handed down from the front, but instead something we believe in, together.',
  },
  {
    title: 'An open invitation',
    body: 'We invite friends into the life of the community, and one another further along in following Jesus.',
  },
  {
    title: 'A habit of generosity',
    body: 'We give our time, skills, and money freely — because we believe in what we’re doing together.',
  },
  {
    title: 'Growing together',
    body: 'We’re committed to growing in faith together, supporting one another along the way.',
  },
  {
    title: 'Love our neighbors',
    body: 'We pray for and serve the people around us — locally in Sammamish and in the broader world.',
  },
  {
    title: 'Everyone has a part',
    body: 'The work of the church belongs to all of us. We all play a role in leading, serving, and carrying it.',
  },
]

const deeperLinks: LinkCardItem[] = [
  {
    href: 'beliefs/',
    title: 'What We Believe',
    meta: 'Our core convictions, shared with the wider Covenant church.',
  },
  {
    href: 'about/pastors-letter/',
    title: 'A Welcome from our Pastor',
    meta: 'A personal letter from Austin Bailey.',
  },
]
---

<BaseLayout
  title="Mission & Vision | Pine Lake Covenant Church"
  description="Where Pine Lake is headed and how we get there: to find and follow Jesus together — being with him, becoming like him, and doing what he did."
>
  <div class="canvas">
    <Split
      class="to-full"
      filename="494466260_18165174907338056_8436364112915676659_n.jpg"
      tone="sand"
      reverse
      eyebrow="About"
    >
      <h1 class="display">Mission &amp; Vision</h1>
      <p class="lede">
        More than anything, we’re a community learning to follow Jesus together. This is who we’re trying to become, and
        the shifts we’re learning to live as we get there.
      </p>
    </Split>

    <section class="section">
      <p class="eyebrow">Our vision</p>
      <div class="vision">
        <p>
          Pine Lake Covenant isn’t here to be the church the world expects us to be, but the community God is calling us
          to be. The vision is short — <em>to find and follow Jesus, together</em> — and it takes a lifetime to live.
        </p>
        <p>That happens in two directions:</p>
        <ul>
          <li>
            <strong>We gather</strong> — to worship, to learn, and to be known by name rather than lost in a crowd.
          </li>
          <li>
            <strong>We’re sent</strong> — back into the neighborhoods, schools, and workplaces of the Sammamish plateau, carrying
            the good news of Jesus into ordinary weeks.
          </li>
        </ul>
      </div>
    </section>

    <section class="section ethos__core" aria-label="How we pursue the vision">
      <p class="eyebrow">Our mission, in three movements</p>
      <ol class="ethos__pillars" role="list">
        {
          pillars.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span class="ethos__pillar-desc">{p.desc}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section">
      <p class="focus-lead">These are six shifts we’re growing into — the shape we pray the vision takes in us:</p>
      <AccentList items={focus} numbered columns={3} />
    </section>

    <LinkCardSection heading="Want to go a little deeper?" links={deeperLinks} />
  </div>
</BaseLayout>

<style>
  .vision {
    max-width: var(--measure);
  }

  .vision p + p {
    margin-top: 1rem;
  }

  .focus-lead {
    max-width: var(--measure);
    margin: 0 0 1.5rem;
    color: var(--color-ink-soft);
  }
</style>

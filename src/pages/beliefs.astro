---
import BaseLayout from '../layouts/BaseLayout.astro'
import Split from '../components/Split.astro'
import Photo from '../components/Photo.astro'
import AccentList from '../components/AccentList.astro'
import { withBase } from '../lib/url'

const tenets = [
  {
    title: 'Scripture',
    body: 'We look to the Bible as the primary guide for understanding who God is and how we are called to live. We trust Scripture to shape our faith, our life together as a church, and our mission in the world.',
  },
  {
    title: 'New life in Christ',
    body: 'Following Jesus involves real transformation — a new beginning marked by forgiveness, grace, and a growing life of love, joy, and peace. This new life is not a one-time event, but a lifelong journey of growth and formation.',
  },
  {
    title: 'The mission of the Church',
    body: 'The Church exists not for itself, but to participate in God’s work of restoring the world: sharing the good news of Jesus, forming disciples, and practicing compassion, mercy, and justice in our communities and beyond.',
  },
  {
    title: 'Life together',
    body: 'Faith is meant to be lived in community. The Church is not primarily a building or an institution, but a fellowship of believers learning to follow Jesus together — and all followers of Christ share in its life and ministry.',
  },
  {
    title: 'The Holy Spirit',
    body: 'God is present and active today through the Holy Spirit, who draws people to Christ, shapes our lives, equips us with gifts, and empowers us to love, serve, and bear witness in the world.',
  },
  {
    title: 'Freedom in Christ',
    body: 'The Good News of the Gospel brings freedom from shame and fear, and offers grace for our failings. United in Christ, we focus on what unites us rather than what divides us — extending generosity where faithful Christians may differ.',
  },
]

const focus = [
  {
    title: 'A shared vision',
    body: 'We hold one aim together, in three simple movements: to be with Jesus, become like Jesus, and do what Jesus did.',
  },
  {
    title: 'An open invitation',
    body: 'We invite freely: friends into the life of the community, and one another further along in following Jesus.',
  },
  {
    title: 'A habit of generosity',
    body: 'We give our time, skill, and money freely — less because something needs funding, more because it’s how grace travels.',
  },
  {
    title: 'Growing together',
    body: 'We’re committed to growing in faith together, and to helping one another grow — no one left to figure it out alone.',
  },
  {
    title: 'Love of neighbor',
    body: 'We pray for, serve, and stay present to the people right around us — on our streets and across the Sammamish plateau.',
  },
  {
    title: 'Everyone has a part',
    body: 'The work of the church belongs to all of us, not only the staff. Ordinary members lead, serve, and carry it.',
  },
]
---

<BaseLayout title="What We Believe | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="481945007_1064667082367947_8529665630976327005_n.jpg"
      tone="sand"
      reverse
      eyebrow="About"
    >
      <h1 class="display">What We Believe</h1>
      <p class="lede">
        Two things shape this page: what Pine Lake Covenant is trying to become, and the core convictions underneath it
        — the historic Christian faith we hold in common with the wider Evangelical Covenant Church.
      </p>
    </Split>

    <section class="section">
      <p class="eyebrow">Our vision</p>
      <div class="vision">
        <p>
          Underneath these convictions is a shared sense of who we’re trying to become. We say it plainly: Pine Lake
          Covenant isn’t here to be the church the world expects us to be, but the community God is calling us to be.
          The vision is short — <em>to find and follow Jesus, together</em> — and it takes a lifetime to live.
        </p>
        <p>
          That happens in two directions. We gather — to worship, to learn, and to be known by name rather than lost in
          a crowd. And we’re sent — back into the neighborhoods, schools, and workplaces of the Sammamish plateau,
          carrying the good news of Jesus into ordinary weeks. What we’re praying toward, in the end, is easy to say and
          hard to picture: <em>in Sammamish, as it is in Heaven</em>.
        </p>
      </div>
      <p class="focus-lead">
        We haven’t arrived at any of this. These are six shifts we’re learning to live — the shape we hope the vision
        takes in us:
      </p>
      <AccentList items={focus} numbered columns={3} />
    </section>

    <section class="section">
      <p class="eyebrow">Six core tenets</p>
      <p class="vision-lead">If you’d like the specifics, here they are.</p>
      <AccentList items={tenets} numbered columns={2} />
    </section>

    <section class="section">
      <div class="creed-note">
        <div class="creed-note__text">
          <p class="eyebrow">Part of something bigger</p>
          <p>
            Pine Lake Covenant Church is part of the <a href={withBase('about/covenant/')}
              >Evangelical Covenant Church</a
            >, a Christian denomination rooted in historic Christian faith and formed in 1885. To go deeper, visit
            <a href="https://covchurch.org">covchurch.org</a> or read the
            <a href="https://covchurch.org/resource/covenant-affirmations/">Covenant Affirmations</a>.
          </p>
        </div>
        <Photo
          filename="ecc.png"
          alt="The Evangelical Covenant Church"
          class="creed-note__logo"
          widths={[260, 520]}
          sizes="(max-width: 640px) 60vw, 220px"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .vision {
    max-width: var(--measure);
  }

  .vision p + p {
    margin-top: 1rem;
  }

  .focus-lead {
    max-width: var(--measure);
    margin: 2rem 0 0;
    color: var(--color-ink-soft);
  }

  .vision-lead {
    max-width: var(--measure);
    margin: 0 0 1.5rem;
    color: var(--color-ink-soft);
  }

  .creed-note {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 2.4vw, 2rem);
    background: var(--color-sand);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
  }

  .creed-note__text {
    max-width: var(--measure);
  }

  .creed-note__text .eyebrow {
    margin-bottom: 0.5rem;
  }

  .creed-note__text p:last-child {
    margin: 0;
  }

  /* Rendered by <Photo>, so the img must be styled globally. */
  :global(.creed-note__logo) {
    width: clamp(9rem, 16vw, 13rem);
    height: auto;
    justify-self: end;
  }

  @media (max-width: 640px) {
    .creed-note {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 1.5rem;
    }

    :global(.creed-note__logo) {
      justify-self: start;
    }
  }
</style>

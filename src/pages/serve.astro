---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Serve | Pine Lake Covenant Church">
  <article class="page">
    <header class="page__header">
      <h1>Serve</h1>
      <p class="page__lede">Serving is one of the fastest ways to meet people and belong.</p>
      <figure class="media">
        <div class="media__frame ratio-16x9">
          <span class="media__label">Hero photo placeholder (serving)</span>
        </div>
      </figure>
    </header>
    <section class="section">
      <h2>Hospitality</h2>
      <p>Greeting people, making coffee, and creating a welcoming environment for everyone.</p>
      <div class="media__frame ratio-16x9">
        <span class="media__label">Photo placeholder</span>
      </div>
    </section>
    <section class="section">
      <h2>Kids & Youth</h2>
      <p>Investing in the next generation by serving with our kids and youth programs.</p>
      <div class="media__frame ratio-16x9">
        <span class="media__label">Photo placeholder</span>
      </div>
    </section>
    <section class="section">
      <h2>Worship & Tech</h2>
      <p>Using your musical or technical gifts to lead others in worship.</p>
      <div class="media__frame ratio-16x9">
        <span class="media__label">Photo placeholder</span>
      </div>
    </section>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Split from '../../components/Split.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import AccentList from '../../components/AccentList.astro'
import Band from '../../components/Band.astro'

const base = import.meta.env.BASE_URL

const emphases = [
  { title: 'Scripture', body: 'We look to the Bible as our primary guide for faith and life.' },
  { title: 'New life in Christ', body: 'Following Jesus is not just an idea; it’s transformation and renewal.' },
  {
    title: 'Mission',
    body: 'The Church exists to share the good news of Jesus and to love and serve the world with compassion and justice.',
  },
  { title: 'Community', body: 'Faith grows best in fellowship, not in isolation.' },
  { title: 'The Holy Spirit', body: 'We depend on the Spirit’s presence and power to guide and equip us.' },
  {
    title: 'Freedom in Christ',
    body: 'We seek unity in essentials, grace in differences, and humility in how we hold our convictions.',
  },
]
---

<BaseLayout title="The Evangelical Covenant Church | Pine Lake Covenant Church">
  <div class="canvas">
    <Split
      class="to-full"
      filename="612510663_18192015196338056_7796982445441955951_n.jpg"
      alt="Members sharing communion together during a service"
      tone="sand"
      reverse
      eyebrow="About"
    >
      <h1 class="display">The Evangelical Covenant Church</h1>
      <p class="lede">
        Pine Lake is part of the Evangelical Covenant Church (often shortened to “the Covenant”) — a wider family of
        churches who share a historic Christian faith, a commitment to the Bible, and a practical focus on following
        Jesus in everyday life.
      </p>
    </Split>

    <section class="section">
      <SectionHeader eyebrow="Why a denomination?" heading="Accountable, supported, connected" />
      <p class="measure">
        For us, being part of a denomination isn’t about being institutional — it’s about being accountable, supported,
        and connected. The Covenant provides shared theology, pastoral care and training, and partnership in mission,
        both locally and globally.
      </p>
    </section>

    <section class="section">
      <SectionHeader eyebrow="What the Covenant emphasizes" heading="A few long-standing convictions" />
      <p class="measure">
        A combination of historic Christian orthodoxy and a warm, lived faith. These are the same convictions we hold at
        Pine Lake — you can read ours in <a href={`${base}about/beliefs/`}>What We Believe</a>.
      </p>
      <AccentList items={emphases} columns={3} />
    </section>

    <section class="section section-callout">
      <h2>A posture of unity and grace</h2>
      <p>
        One distinctive of the Covenant is our desire to focus on what unites followers of Jesus rather than what
        divides us. Where faithful Christians may differ on secondary issues, we aim to be thoughtful, generous, and
        grounded — keeping Jesus at the center.
      </p>
    </section>

    <section class="section">
      <SectionHeader eyebrow="Connected beyond Pine Lake" heading="Part of a global family" />
      <p class="measure">
        Being Covenant connects Pine Lake to churches across the U.S. and around the world, as well as missionaries and
        partner organizations. It also provides oversight and support for our pastors and leaders.
      </p>
    </section>

    <Band tone="forest" flush narrow eyebrow="Go deeper" heading="Explore the wider Covenant">
      <p>Learn more about the Covenant family of churches — its history, its mission, and its theology.</p>
      <p class="covenant-cta__links">
        <a class="btn" href="https://covchurch.org" target="_blank" rel="noopener">Visit covchurch.org</a>
        <a
          class="btn btn--ghost"
          href="https://covchurch.org/resource/covenant-affirmations/"
          target="_blank"
          rel="noopener"
        >
          Covenant Affirmations
        </a>
      </p>
    </Band>
  </div>
</BaseLayout>

<style>
  /* The two CTA buttons sit in a row beneath the copy */
  .covenant-cta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Split from '../../components/Split.astro'
import LinkCardSection from '../../components/LinkCardSection.astro'
import type { LinkCardItem } from '../../components/LinkCardSection.astro'

const pillars = [
  {
    title: 'Be with Jesus',
    desc: 'Staying close to him — through prayer, the Bible, worship, and rest.',
  },
  {
    title: 'Become like Jesus',
    desc: 'Letting his character slowly reshape ours, over a lifetime.',
  },
  {
    title: 'Do what Jesus did',
    desc: 'Loving and serving the people around us, and our wider community.',
  },
]

const deeperLinks: LinkCardItem[] = [
  {
    href: 'about/beliefs/',
    title: 'What We Believe',
    meta: 'Our core convictions, shared with the wider Covenant church.',
  },
  {
    href: 'about/pastors-letter/',
    title: 'A Welcome from our Pastor',
    meta: 'A personal letter from Austin Bailey.',
  },
]
---

<BaseLayout
  title="What We’re About | Pine Lake Covenant Church"
  description="What shapes life together at Pine Lake, in plain language: being with Jesus, becoming like him, and doing what he did."
>
  <div class="canvas">
    <Split
      class="to-full"
      filename="494466260_18165174907338056_8436364112915676659_n.jpg"
      alt="A family wearing “love thy neighbor” shirts on a Sunday morning"
      tone="sand"
      reverse
      eyebrow="Get to know us"
    >
      <h1 class="display">What We’re About</h1>
      <p class="lede">
        We try to keep things simple. More than anything, we’re a community learning to follow Jesus together — and that
        shapes how we show up for one another and for our neighbors.
      </p>
    </Split>

    <section class="section ethos__core" aria-label="What shapes us">
      <ol class="ethos__pillars" role="list">
        {
          pillars.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span class="ethos__pillar-desc">{p.desc}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <LinkCardSection heading="Want to go a little deeper?" links={deeperLinks} />
  </div>
</BaseLayout>

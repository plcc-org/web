---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Photo from '../../components/Photo.astro'
---

<BaseLayout title="Leadership | Pine Lake Covenant Church">
  <article class="page page--wide">
    <header class="page__header prose-measure">
      <h1>Leadership</h1>
      <p class="page__lede">Our Pastors and Staff</p>
    </header>
    <section class="section">
      <div class="leader-grid">
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-4x5">
              <Photo
                filename="Austin-2025-5-web.jpg"
                alt="Austin Bailey, Lead Pastor"
                class="media__img media__img--cover"
                widths={[280, 560]}
                sizes="(max-width: 600px) 100vw, 360px"
              />
            </div>
          </div>
          <div class="leader-card__name">Austin Bailey</div>
          <div class="leader-card__title">Lead Pastor</div>
          <p class="leader-card__meta">
            <a href={`${import.meta.env.BASE_URL}about/pastors-letter/`}>Read a letter from Austin</a>
          </p>
        </div>
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-4x5">
              <Photo
                filename="Becca-2025-5-web.jpg"
                alt="Becca Worl, Associate Pastor"
                class="media__img media__img--cover"
                widths={[280, 560]}
                sizes="(max-width: 600px) 100vw, 360px"
              />
            </div>
          </div>
          <div class="leader-card__name">Becca Worl</div>
          <div class="leader-card__title">Associate Pastor</div>
        </div>
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-4x5">
              <Photo
                filename="Kyle-2025-5-web.jpg"
                alt="Kyle Harmon, Associate Pastor, Worship and Outreach"
                class="media__img media__img--cover"
                widths={[280, 560]}
                sizes="(max-width: 600px) 100vw, 360px"
              />
            </div>
          </div>
          <div class="leader-card__name">Kyle Harmon</div>
          <div class="leader-card__title">Associate Pastor, Worship and Outreach</div>
        </div>
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-4x5">
              <Photo
                filename="Kim-2025-5-web.jpg"
                alt="Kim Witherbee, Director, Facilities and Ministries"
                class="media__img media__img--cover"
                widths={[280, 560]}
                sizes="(max-width: 600px) 100vw, 360px"
              />
            </div>
          </div>
          <div class="leader-card__name">Kim Witherbee</div>
          <div class="leader-card__title">Director, Facilities & Ministries</div>
        </div>
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-4x5">
              <Photo
                filename="Scott-2025-5-web.jpg"
                alt="Scott Jones, Director, Communications"
                class="media__img media__img--cover"
                widths={[280, 560]}
                sizes="(max-width: 600px) 100vw, 360px"
              />
            </div>
          </div>
          <div class="leader-card__name">Scott Jones</div>
          <div class="leader-card__title">Director, Communications</div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

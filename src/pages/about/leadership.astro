---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Leadership | Pine Lake Covenant Church">
  <article class="page">
    <header class="page__header">
      <h1>Leadership</h1>
      <p class="page__lede">Pastors and leaders of Pine Lake Covenant Church.</p>
    </header>
    <section class="section">
      <div class="leader-grid">
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-1x1">
              <span class="media__label">Headshot</span>
            </div>
          </div>
          <div class="leader-card__name">Firstname Lastname</div>
          <div class="leader-card__title">Lead Pastor</div>
        </div>
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-1x1">
              <span class="media__label">Headshot</span>
            </div>
          </div>
          <div class="leader-card__name">Firstname Lastname</div>
          <div class="leader-card__title">Associate Pastor</div>
        </div>
        <div class="leader-card">
          <div class="leader-card__photo">
            <div class="media__frame ratio-1x1">
              <span class="media__label">Headshot</span>
            </div>
          </div>
          <div class="leader-card__name">Firstname Lastname</div>
          <div class="leader-card__title">Director of Youth & Families</div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

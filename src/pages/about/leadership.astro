---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageIntro from '../../components/PageIntro.astro'
import Photo from '../../components/Photo.astro'
import { getCollection } from 'astro:content'
import { renderMarkdown } from '../../lib/markdown'
import { imageFromRef } from '../../lib/images'
import { resolveHref } from '../../lib/url'

// Portraits are stored as path strings and resolved here, the same way the CMS
// block wrappers resolve theirs — see the note on the collection in
// src/content.config.ts for why they aren't Astro's image() helper.
const leaders = await Promise.all(
  (await getCollection('leadership'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (leader) => ({
      ...leader,
      portrait: (await imageFromRef(leader.data.portrait)?.())?.default,
      portraitAlt: leader.data.portraitAlt || `${leader.data.name}, ${leader.data.title}`,
    }))
)
---

<BaseLayout
  title="Leadership"
  description="The pastors and staff at Pine Lake Covenant Church in Sammamish — who they are and how they got here."
>
  <div class="canvas">
    <PageIntro eyebrow="About" title="Leadership" subhead="Our pastors and staff" />
    <section class="leader-section">
      <div class="leader-grid">
        {
          leaders.map((leader) => (
            /* Heading-wrapping-a-button, per the ARIA Authoring Practices
               disclosure pattern. The names have to be headings or the roster
               contributes nothing to the document outline and heading
               navigation skips the page. A heading can't live *inside* a
               <button> (phrasing content only), so it wraps it — which makes
               the h2 the grid item, hence width:100% on the button. */
            <h2 class="leader-card-heading">
              <button
                type="button"
                class="leader-card"
                data-leader={leader.id}
                aria-expanded="false"
                aria-controls={`detail-${leader.id}`}
              >
                <span class="leader-card__photo" data-portrait>
                  <span class="media__frame ratio-4x5">
                    <Photo
                      image={leader.portrait}
                      alt={leader.portraitAlt}
                      class="media__img media__img--cover"
                      widths={[280, 560]}
                      sizes="(max-width: 600px) 100vw, 360px"
                    />
                  </span>
                </span>
                <span class="leader-card__name">{leader.data.name}</span>
                <span class="leader-card__title">{leader.data.title}</span>
              </button>
            </h2>
          ))
        }
      </div>

      <div class="leader-focus">
        {
          leaders.map((leader) => (
            <article
              class="leader-detail"
              id={`detail-${leader.id}`}
              data-leader={leader.id}
              aria-labelledby={`detail-${leader.id}-name`}
              hidden
            >
              <div class="leader-detail__photo" data-portrait>
                <div class="media__frame ratio-4x5">
                  <Photo
                    image={leader.portrait}
                    alt={leader.portraitAlt}
                    class="media__img media__img--cover"
                    widths={[480, 960]}
                    sizes="(max-width: 600px) 100vw, 420px"
                  />
                </div>
              </div>
              <div class="leader-detail__body">
                <h2 id={`detail-${leader.id}-name`} class="leader-card__name leader-detail__name">
                  {leader.data.name}
                </h2>
                <p class="leader-card__title leader-detail__title">{leader.data.title}</p>
                <div class="leader-detail__prose measure" set:html={renderMarkdown(leader.data.bio)} />
                {leader.data.link?.href && (
                  <p class="leader-detail__meta">
                    <a href={resolveHref(leader.data.link.href)}>{leader.data.link.label}</a>
                  </p>
                )}
                <button type="button" class="leader-detail__close" aria-label="Back to all staff">
                  <span aria-hidden="true">←</span> All staff
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const section = document.querySelector<HTMLElement>('.leader-section')
  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLButtonElement>('.leader-card'))
    const details = Array.from(section.querySelectorAll<HTMLElement>('.leader-detail'))
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)')

    const cardFor = (slug: string) => cards.find((c) => c.dataset.leader === slug) ?? null
    const detailFor = (slug: string) => details.find((d) => d.dataset.leader === slug) ?? null
    const portraitOf = (el: Element | null) => el?.querySelector<HTMLElement>('[data-portrait]') ?? null

    let activeSlug: string | null = null

    // The actual DOM swap — wrapped in a view transition by run() below.
    const applyState = (slug: string | null) => {
      activeSlug = slug
      section.classList.toggle('is-focused', slug !== null)
      for (const card of cards) card.setAttribute('aria-expanded', String(card.dataset.leader === slug))
      for (const detail of details) detail.hidden = detail.dataset.leader !== slug
    }

    // Tag the outgoing card portrait and incoming detail portrait with a shared
    // name so the browser morphs one into the other; clear it afterwards so the
    // name stays unique to a single transition.
    //
    // Resolves once the DOM swap has been applied (not when the animation ends).
    // Callers must await this before moving focus: the grid and the panel take
    // turns at `display: none`, and .focus() on a display:none element is
    // silently a no-op. requestAnimationFrame is not a substitute — it fires
    // *before* startViewTransition runs its callback, so focus would land on
    // an element that is still hidden and fall through to <body>.
    const run = async (slug: string | null, fromSlug: string | null): Promise<void> => {
      const supportsVT = typeof document.startViewTransition === 'function'
      if (!supportsVT || prefersReduced.matches) {
        applyState(slug)
        return
      }
      // Opening: morph card → detail. Closing: morph detail → card.
      const opening = slug !== null
      const morphSlug = opening ? slug : fromSlug
      const fromPortrait = portraitOf(opening ? cardFor(morphSlug!) : detailFor(morphSlug!))
      const toPortrait = portraitOf(opening ? detailFor(morphSlug!) : cardFor(morphSlug!))
      if (fromPortrait) fromPortrait.style.viewTransitionName = 'leader-portrait'
      if (toPortrait) toPortrait.style.viewTransitionName = 'leader-portrait'
      const transition = document.startViewTransition(() => applyState(slug))
      transition.finished.finally(() => {
        if (fromPortrait) fromPortrait.style.viewTransitionName = ''
        if (toPortrait) toPortrait.style.viewTransitionName = ''
      })
      // Swallow rejection so callers can chain focus onto it unconditionally.
      await transition.updateCallbackDone.catch(() => {})
    }

    // Where the reader was in the grid when they opened a profile, so closing
    // puts them back there. Focus alone doesn't do this: .focus() scrolls the
    // element into view on its own terms, which lands you somewhere near the
    // card rather than where you were standing.
    let scrollBeforeOpen: number | null = null

    const open = (slug: string, push = true) => {
      if (!detailFor(slug) || slug === activeSlug) return
      const from = activeSlug
      if (from === null) scrollBeforeOpen = window.scrollY
      const swapped = run(slug, from)
      if (push) history.pushState(null, '', `#${slug}`)
      // Focus the panel once it's actually visible. preventScroll because the
      // panel has already replaced the grid in the viewport — there's nothing
      // to scroll to, and letting the browser try only shifts the page.
      swapped.then(() =>
        detailFor(slug)?.querySelector<HTMLButtonElement>('.leader-detail__close')?.focus({ preventScroll: true })
      )
    }

    const close = (push = true) => {
      if (activeSlug === null) return
      const from = activeSlug
      const swapped = run(null, from)
      if (push) history.pushState(null, '', window.location.pathname + window.location.search)
      swapped.then(() => {
        // Restore the scroll position first, then focus without scrolling: the
        // card is back under the cursor where the reader left it, and keyboard
        // users still resume from the card they opened.
        if (scrollBeforeOpen !== null) window.scrollTo({ top: scrollBeforeOpen, behavior: 'instant' as ScrollBehavior })
        scrollBeforeOpen = null
        cardFor(from)?.focus({ preventScroll: true })
      })
    }

    for (const card of cards) {
      card.addEventListener('click', () => open(card.dataset.leader!))
    }
    for (const detail of details) {
      detail.querySelector<HTMLButtonElement>('.leader-detail__close')?.addEventListener('click', () => close())
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeSlug !== null) close()
    })

    // Sync to the URL hash: deep links on load, plus Back/Forward navigation.
    const syncToHash = (push = false) => {
      const slug = window.location.hash.replace(/^#/, '')
      if (slug && detailFor(slug)) open(slug, push)
      else close(push)
    }
    window.addEventListener('popstate', () => syncToHash(false))
    // Initial load: open without animating, no extra history entry.
    if (window.location.hash) {
      const slug = window.location.hash.replace(/^#/, '')
      if (detailFor(slug)) applyState(slug)
    }
  }
</script>

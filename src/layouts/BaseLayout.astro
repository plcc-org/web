---
import { getImage, Font } from 'astro:assets'
import { withBase } from '../lib/url'
import { churchGraph, jsonLdDocument } from '../lib/structured-data'
import '../styles/global.css'
import instagramGlyphUrl from '../assets/images/Instagram_Glyph_White.svg?url'
import youtubeIconUrl from '../assets/images/yt_icon_white_digital.png?url'
import wordmarkUrl from '../assets/images/Horizontal-Logo-White-on-Transparent.png?url'
import socialImageSource from '../assets/images/plcc-social-card.png'
import iconSource from '../assets/images/plcc-logo-icon.jpg'
import faviconSource from '../assets/images/plcc-logo.png'

type Props = {
  title?: string
  description?: string
  noindex?: boolean
  /**
   * Extra schema.org nodes to merge into the page's `@graph` alongside the
   * Church node emitted here (see src/lib/structured-data.ts). Pages that have
   * something genuinely additional to declare — the events board, for
   * instance — pass it; most pages don't need this.
   */
  structuredData?: Record<string, unknown>[]
}

const {
  title = 'Pine Lake Covenant Church',
  description = 'A church in Sammamish, discovering life with Jesus together.',
  noindex = false,
  structuredData = [],
}: Props = Astro.props

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined

// The share card carries no photo — just the wordmark on the hero glow (see
// scripts/generate-social-card.mjs) — so one alt string covers every page.
const SOCIAL_IMAGE_ALT = 'The Pine Lake Covenant Church wordmark on a deep green background'

// Social share image (1200x630), Apple touch icon, and favicons, generated at build time.
const socialImage = await getImage({ src: socialImageSource, width: 1200, height: 630, fit: 'cover', format: 'png' })
const appleTouchIcon = await getImage({ src: iconSource, width: 180, height: 180, fit: 'cover', format: 'png' })
// Favicon uses the transparent logo so it sits cleanly on any tab background.
const favicon16 = await getImage({ src: faviconSource, width: 16, height: 16, format: 'png' })
const favicon32 = await getImage({ src: faviconSource, width: 32, height: 32, format: 'png' })
// Open Graph images must be absolute URLs.
const socialImageUrl = Astro.site ? new URL(socialImage.src, Astro.site).toString() : socialImage.src

// Structured data needs absolute `@id`s to be stable, so it only emits when a
// `site` origin is configured — i.e. staging and production, never dev. Same
// guard the canonical link uses.
const origin = Astro.site ? Astro.site.origin : undefined
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path)
const jsonLd = origin
  ? jsonLdDocument([
      ...churchGraph(origin, { logo: absolute(appleTouchIcon.src), image: socialImageUrl }),
      ...structuredData,
    ])
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Self-hosted fonts (Astro Fonts API). Preload only the upright styles used
         above the fold; italics load on demand. -->
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-instrument-sans" preload={[{ style: 'normal' }]} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#6a9529" />

    <!-- Icons + PWA manifest -->
    <link rel="icon" href={favicon32.src} type="image/png" sizes="32x32" />
    <link rel="icon" href={favicon16.src} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pine Lake Covenant Church" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* The card is the same for every page, so its alt text is fixed too. */}
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />

    {/* schema.org graph — Church + Place, plus anything the page adds. */}
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <nav class="site-nav" aria-label="Primary">
        <div class="site-nav__bar">
          <a href={withBase()} class="site-nav__home" aria-label="Pine Lake Covenant Church — Home">
            <span class="site-nav__home-logo" style={`--logo-wordmark-url: url('${wordmarkUrl}')`} aria-hidden="true"
            ></span>
          </a>
          <button
            class="site-nav__toggle"
            aria-expanded="false"
            aria-controls="primary-nav-menu"
            aria-label="Open navigation menu"
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
        </div>
        <ul class="site-nav__list" id="primary-nav-menu">
          <li><a href={withBase('new/')}>I’m New</a></li>
          <li><a href={withBase('about/')}>About</a></li>
          <li><a href={withBase('families/')}>Families</a></li>
          <li><a href={withBase('neighbors/')}>For Our Neighbors</a></li>
          <li><a href={withBase('church-life/')}>Church Life</a></li>
          <li><a href={withBase('events/')}>What’s On</a></li>
          <li><a href={withBase('messages/')}>Messages</a></li>
          <li><a href={withBase('visit/')} class="site-nav__cta">Plan a Visit</a></li>
        </ul>
      </nav>
    </header>

    <main class="site-main" id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__main">
        <div class="site-footer__info">
          <strong>Pine Lake Covenant Church</strong>
          <span class="site-footer__divider">|</span>
          <span>Sundays at 10:00am</span>
          <span class="site-footer__divider">|</span>
          <a href="https://maps.apple/p/1EFyth--T~mePq" target="_blank" rel="noopener"
            >1715 228th Ave SE, Sammamish, WA 98075</a
          >
          <span class="site-footer__divider">|</span>
          <a href="mailto:office@plcc.org">office@plcc.org</a>
        </div>

        <nav class="site-footer__links" aria-label="Footer">
          <a href={withBase('visit/')}>Plan a Visit</a>
          <span class="site-footer__divider">|</span>
          <a href={withBase('contact/')}>Contact</a>
          <span class="site-footer__divider">|</span>
          <a
            href="https://www.instagram.com/pinelakecov/"
            target="_blank"
            rel="noopener"
            class="site-footer__social-link"
          >
            <img
              src={instagramGlyphUrl}
              alt=""
              aria-hidden="true"
              class="site-footer__social-icon site-footer__social-icon--instagram"
            />
            <span>Instagram</span>
          </a>
          <span class="site-footer__divider">|</span>
          <a
            href="https://www.youtube.com/@PineLkCovChurch"
            target="_blank"
            rel="noopener"
            class="site-footer__social-link"
          >
            <img
              src={youtubeIconUrl}
              alt=""
              aria-hidden="true"
              class="site-footer__social-icon site-footer__social-icon--youtube"
            />
            <span>YouTube</span>
          </a>
        </nav>

        <p class="site-footer__legal">© {new Date().getFullYear()} Pine Lake Covenant Church</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Frost the sticky header once the page has scrolled past the top.
  const header = document.querySelector<HTMLElement>('.site-header')
  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 8)
  setScrolled()
  window.addEventListener('scroll', setScrolled, { passive: true })

  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle')
  const nav = toggle?.closest('.site-nav')

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false
    toggle.setAttribute('aria-expanded', String(isOpen))
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu')
  })

  // Close when clicking outside the nav
  document.addEventListener('click', (e) => {
    if (nav?.classList.contains('is-open') && !nav.contains(e.target as Node)) {
      nav.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.setAttribute('aria-label', 'Open navigation menu')
    }
  })

  // Close when a nav link is followed
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.setAttribute('aria-label', 'Open navigation menu')
    })
  })

  // Scroll reveal — arm only when JS is present and motion is welcome, so
  // content stays visible without JS or under prefers-reduced-motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const revealables = document.querySelectorAll('[data-reveal]')
  if (!reduceMotion && revealables.length) {
    document.documentElement.classList.add('reveal-ready')
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    )
    revealables.forEach((el) => observer.observe(el))
  }
</script>

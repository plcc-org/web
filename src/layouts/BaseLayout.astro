---
import { getImage } from 'astro:assets'
import '../styles/global.css'
import instagramGlyphUrl from '../assets/images/Instagram_Glyph_White.svg?url'
import youtubeIconUrl from '../assets/images/yt_icon_white_digital.png?url'
import wordmarkUrl from '../assets/images/Horizontal-Logo-White-on-Transparent.png?url'
import socialImageSource from '../assets/images/plcc-community-family-worship.jpg'
import iconSource from '../assets/images/plcc-logo-icon.jpg'

const {
  title = 'Pine Lake Covenant Church',
  description = 'A church in Sammamish, discovering life with Jesus together.',
  noindex = false,
} = Astro.props

const base = import.meta.env.BASE_URL
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined

// Social share image (1200x630) and Apple touch icon, generated at build time.
const socialImage = await getImage({ src: socialImageSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
const appleTouchIcon = await getImage({ src: iconSource, width: 180, height: 180, fit: 'cover', format: 'png' })
// Open Graph images must be absolute URLs.
const socialImageUrl = Astro.site ? new URL(socialImage.src, Astro.site).toString() : socialImage.src
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#6a9529" />

    <!-- Icons + PWA manifest -->
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pine Lake Covenant Church" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <nav class="site-nav" aria-label="Primary">
        <div class="site-nav__bar">
          <a href={`${import.meta.env.BASE_URL}`} class="site-nav__home" aria-label="Pine Lake Covenant Church — Home">
            <span class="site-nav__home-logo" style={`--logo-wordmark-url: url('${wordmarkUrl}')`} aria-hidden="true"
            ></span>
          </a>
          <button
            class="site-nav__toggle"
            aria-expanded="false"
            aria-controls="primary-nav-menu"
            aria-label="Open navigation menu"
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
        </div>
        <ul class="site-nav__list" id="primary-nav-menu">
          <li><a href={`${import.meta.env.BASE_URL}im-new/`}>I’m New</a></li>
          <li><a href={`${import.meta.env.BASE_URL}about/`}>About</a></li>
          <li><a href={`${import.meta.env.BASE_URL}families/`}>Families</a></li>
          <li><a href={`${import.meta.env.BASE_URL}for-our-neighbors/`}>For Our Neighbors</a></li>
          <li><a href={`${import.meta.env.BASE_URL}whats-happening/`}>What’s Happening</a></li>
          <li><a href={`${import.meta.env.BASE_URL}messages/`}>Messages</a></li>
          <li><a href={`${import.meta.env.BASE_URL}plan-a-visit/`} class="site-nav__cta">Plan a Visit</a></li>
        </ul>
      </nav>
    </header>

    <main class="site-main" id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__main">
        <div class="site-footer__info">
          <strong>Pine Lake Covenant Church</strong>
          <span class="site-footer__divider">|</span>
          <span>Sundays at 10:00am</span>
          <span class="site-footer__divider">|</span>
          <a href="https://maps.apple/p/1EFyth--T~mePq" target="_blank" rel="noopener"
            >1715 228th Ave SE, Sammamish, WA 98075</a
          >
          <span class="site-footer__divider">|</span>
          <a href="mailto:office@plcc.org">office@plcc.org</a>
        </div>

        <nav class="site-footer__links" aria-label="Footer">
          <a href={`${import.meta.env.BASE_URL}plan-a-visit/`}>Plan a Visit</a>
          <span class="site-footer__divider">|</span>
          <a href={`${import.meta.env.BASE_URL}contact/`}>Contact</a>
          <span class="site-footer__divider">|</span>
          <a href={`${import.meta.env.BASE_URL}community/`}>Community</a>
          <span class="site-footer__divider">|</span>
          <a
            href="https://www.instagram.com/pinelakecov/"
            target="_blank"
            rel="noopener"
            class="site-footer__social-link"
          >
            <img
              src={instagramGlyphUrl}
              alt=""
              aria-hidden="true"
              class="site-footer__social-icon site-footer__social-icon--instagram"
            />
            <span>Instagram</span>
          </a>
          <span class="site-footer__divider">|</span>
          <a
            href="https://www.youtube.com/@PineLkCovChurch"
            target="_blank"
            rel="noopener"
            class="site-footer__social-link"
          >
            <img
              src={youtubeIconUrl}
              alt=""
              aria-hidden="true"
              class="site-footer__social-icon site-footer__social-icon--youtube"
            />
            <span>YouTube</span>
          </a>
        </nav>

        <p class="site-footer__legal">© {new Date().getFullYear()} Pine Lake Covenant Church</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Frost the sticky header once the page has scrolled past the top.
  const header = document.querySelector<HTMLElement>('.site-header')
  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 8)
  setScrolled()
  window.addEventListener('scroll', setScrolled, { passive: true })

  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle')
  const nav = toggle?.closest('.site-nav')

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false
    toggle.setAttribute('aria-expanded', String(isOpen))
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu')
  })

  // Close when clicking outside the nav
  document.addEventListener('click', (e) => {
    if (nav?.classList.contains('is-open') && !nav.contains(e.target as Node)) {
      nav.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.setAttribute('aria-label', 'Open navigation menu')
    }
  })

  // Close when a nav link is followed
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.setAttribute('aria-label', 'Open navigation menu')
    })
  })
</script>

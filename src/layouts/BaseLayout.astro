---
import { getImage, Font } from 'astro:assets'
import { withBase } from '../lib/url'
import { churchGraph, jsonLdDocument } from '../lib/structured-data'
import { brand, church } from '../config/church'
import { squareIcon } from '../lib/icons'
import SiteHeader from '../components/chrome/SiteHeader.astro'
import SiteFooter from '../components/chrome/SiteFooter.astro'
import ScrollReveal from '../components/chrome/ScrollReveal.astro'
import SlimHeader from '../components/chrome/SlimHeader.astro'
import SlimFooter from '../components/chrome/SlimFooter.astro'
import '../styles/global.css'
import socialImageSource from '../assets/images/plcc-social-card.png'
import faviconSource from '../assets/images/plcc-logo.png'

type Props = {
  /** The bare page title — the layout appends " | Pine Lake Covenant Church". */
  title?: string
  /** A verbatim tab title that wins over `title` (the home page's custom one). */
  seoTitle?: string
  description?: string
  noindex?: boolean
  /**
   * Extra schema.org nodes to merge into the page's `@graph` alongside the
   * Church node emitted here (see src/lib/structured-data.ts). Pages that have
   * something genuinely additional to declare — the events board, for
   * instance — pass it; most pages don't need this.
   */
  structuredData?: Record<string, unknown>[]
  /**
   * `full` is the site's header, nav and footer. `slim` is a wordmark and a short
   * footer with no script, for a page people open on a phone from a tag in the
   * building (/links/) — see docs/design-system.md. Only the full chrome's
   * components carry scripts, so a slim page ships none of them.
   */
  chrome?: 'full' | 'slim'
}

const {
  title,
  seoTitle,
  description = church.description,
  noindex = false,
  structuredData = [],
  chrome = 'full',
}: Props = Astro.props

// The suffix lives here, once, so pages pass bare titles.
const tabTitle = seoTitle || (title ? `${title} | ${church.name}` : church.name)

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined

// The share card carries no photo — just the wordmark on the hero glow (see
// scripts/generate-social-card.mjs) — so one alt string covers every page.
const SOCIAL_IMAGE_ALT = 'The Pine Lake Covenant Church wordmark on a deep green background'

// Social share image (1200x630), Apple touch icon, and favicons, generated at build time.
const socialImage = await getImage({ src: socialImageSource, width: 1200, height: 630, fit: 'cover', format: 'png' })
const appleTouchIcon = await squareIcon(180)
// Favicon uses the transparent logo so it sits cleanly on any tab background.
const favicon16 = await getImage({ src: faviconSource, width: 16, height: 16, format: 'png' })
const favicon32 = await getImage({ src: faviconSource, width: 32, height: 32, format: 'png' })
// Open Graph images must be absolute URLs.
const socialImageUrl = Astro.site ? new URL(socialImage.src, Astro.site).toString() : socialImage.src

// Structured data needs absolute `@id`s to be stable, so it only emits when a
// `site` origin is configured — i.e. staging and production, never dev. Same
// guard the canonical link uses.
const origin = Astro.site ? Astro.site.origin : undefined
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path)
const jsonLd = origin
  ? jsonLdDocument([
      ...churchGraph(origin, { logo: absolute(appleTouchIcon.src), image: socialImageUrl }),
      ...structuredData,
    ])
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Self-hosted fonts (Astro Fonts API). Preload only the upright styles used
         above the fold; italics load on demand. -->
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-instrument-sans" preload={[{ style: 'normal' }]} />

    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content={brand.theme} />

    <!-- Icons + PWA manifest -->
    <link rel="icon" href={favicon32.src} type="image/png" sizes="32x32" />
    <link rel="icon" href={favicon16.src} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={church.name} />
    <meta property="og:title" content={tabTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* The card is the same for every page, so its alt text is fixed too. */}
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tabTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />

    {/* schema.org graph — Church + Place, plus anything the page adds. */}
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    {chrome === 'slim' ? <SlimHeader /> : <SiteHeader />}

    <main class="site-main" id="main-content">
      <slot />
    </main>

    {chrome === 'slim' ? <SlimFooter /> : <SiteFooter />}
    {chrome === 'full' && <ScrollReveal />}
  </body>
</html>

---
import { resolveHref } from '../../lib/url'
import { blockField } from '../../lib/tina/block-field'
import { linkKind } from '../../../tina/sunday-links.mjs'

// One list of Sunday links. Each row is a single tap target, with an icon that says
// what tapping does: leave for another site, write an email, or open a page here.
//
// Links open in the same tab, unlike everywhere else on the site (isWebUrl in
// src/lib/url.ts). Someone who arrived from a tag in the building is working through a
// list on their phone: Back should bring them straight back to it, not leave them
// hunting through a stack of tabs.
//
// A row the editor hasn't finished (no label or no address yet) is skipped rather than
// rendered as a dead tap target.
type Link = { label?: string | null; url?: string | null; _content_source?: unknown }
type Props = { links?: (Link | null)[] | null; quiet?: boolean }

const { links, quiet = false } = Astro.props
const rows = (links ?? []).filter((link): link is Link & { label: string; url: string } =>
  Boolean(link?.label && link?.url)
)
---

{
  rows.length > 0 && (
    <ul class:list={['sunday-links__list', { 'sunday-links__list--quiet': quiet }]} role="list">
      {rows.map((link) => {
        const kind = linkKind(link.url)
        return (
          <li data-tina-field={blockField(link)}>
            <a class="sunday-link" href={resolveHref(link.url)}>
              <span class="sunday-link__label">
                {link.label}
                {kind === 'mail' && <span class="visually-hidden"> (email)</span>}
              </span>
              <svg
                class="sunday-link__icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {kind === 'mail' && (
                  <>
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </>
                )}
                {kind === 'site' && <path d="M5 12h14M13 6l6 6-6 6" />}
                {kind === 'web' && <path d="M7 17 17 7M8 7h9v9" />}
              </svg>
            </a>
          </li>
        )
      })}
    </ul>
  )
}

---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { assetPath } from '../lib/images'
import { withBase } from '../lib/url'

// Thin wrapper around Astro's getImage: a resolved `image` (from imageFromRef or
// a content-collection field) plus its `alt`. Callers rendering catalogued
// photos resolve the alt with altFor (src/lib/photos.ts), which falls back to
// the photo catalog when the page didn't write its own. Emits an optimized,
// responsive WebP <img> with intrinsic width/height (no layout shift). Renders
// nothing without an image, so callers don't need their own fallback. Astro
// caps generated widths at the source width, so oversized `widths` are harmless.

type Props = {
  image?: ImageMetadata
  alt?: string
  class?: string
  widths?: number[]
  sizes?: string
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
}

const {
  image,
  alt,
  class: className,
  widths = [480, 960, 1440],
  sizes = '(max-width: 1100px) 100vw, 1100px',
  loading = 'lazy',
  fetchpriority,
} = Astro.props

// Everything renders as WebP — a per-call override has never been needed.
const format = 'webp'

const src = image
const resolvedAlt = alt ?? ''

// Fall back to the unoptimised original when no image service is available.
//
// `imageService: 'compile'` gives Astro's build-time sharp service to prerendered
// routes only. The CMS preview re-renders a region through /tina-island, the
// site's one on-demand route, where there is no service — so getImage returns a
// generic /_image endpoint URL. The adapter's runtime /_image only passes the
// original through from the deployed assets, and prune-dist removes those (and a
// just-uploaded photo was never built at all), so it 404s: the preview shows
// broken images while the live page is perfect.
//
// This tests for that outcome rather than for the context. Detecting the island
// directly isn't possible: it renders through Astro's Container API without a
// request, so `Astro.url` is not the island's URL. Asking what `getImage` would
// produce works wherever the component is used, including anywhere on-demand we
// add later. `import.meta.env.PROD` keeps dev on the normal path — dev serves
// /_image happily, and we want dev exercising what production does.
//
// The original is bigger than the WebP a live page serves, which is the right
// trade for a preview one editor sees at a time. It is fetched from
// /assets/images/<file> — the stored-form path, served by tinaAssetsDevPlugin in
// dev and the generated CDN redirect in production — which covers every photo in
// the library, including one no page references yet.
//
// The one getImage call is also what the normal path renders — the same markup
// Astro's <Image> emits, which would otherwise run the whole transform again.
const built = src
  ? await getImage({
      src,
      widths,
      sizes,
      format,
      alt: resolvedAlt,
      class: className,
      loading,
      decoding: 'async',
      fetchpriority,
    })
  : undefined
const unoptimised = import.meta.env.PROD && built?.src.startsWith('/_image') ? src : undefined
const unoptimisedPath = unoptimised && assetPath(unoptimised)
const unoptimisedSrc = unoptimisedPath ? withBase(unoptimisedPath) : unoptimised?.src
const { class: builtClass, ...builtAttributes } = built?.attributes ?? {}
---

{src &&
  (unoptimised ? (
    <img
      src={unoptimisedSrc}
      alt={resolvedAlt}
      class={className}
      width={unoptimised.width}
      height={unoptimised.height}
      loading={loading}
      decoding="async"
    />
  ) : (
    built && (
      <img
        src={built.src}
        srcset={built.srcSet.values.length > 0 ? built.srcSet.attribute : undefined}
        {...builtAttributes}
        class={builtClass}
      />
    )
  ))}

---
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { imageLoader } from '../lib/images'
import { photoAlt } from '../lib/photos'

// Thin wrapper around Astro's <Image>. Provide EITHER:
//   • `image` — a resolved ImageMetadata (e.g. a content-collection image() field), or
//   • `filename` — a name in src/assets/images, resolved via import.meta.glob.
// Alt text: for catalogued photos, omit `alt` and it's looked up by filename from
// the photo catalog (src/content/photos.json). Pass `alt` explicitly for logos and
// adornments (not in the catalog) or to override. Emits an optimized, responsive
// WebP <img> with intrinsic width/height (no layout shift). Renders nothing if a
// filename can't be resolved, so callers don't need their own fallback. Astro caps
// generated widths at the source width, so oversized `widths` are harmless.

type Props = {
  image?: ImageMetadata
  filename?: string
  alt?: string
  class?: string
  widths?: number[]
  sizes?: string
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
  format?: 'webp' | 'avif' | 'png' | 'jpeg'
}

const {
  image,
  filename,
  alt,
  class: className,
  widths = [480, 960, 1440],
  sizes = '(max-width: 1100px) 100vw, 1100px',
  loading = 'lazy',
  fetchpriority,
  format = 'webp',
} = Astro.props

const loader = !image && filename ? imageLoader(filename) : undefined
const src = image ?? (loader ? (await loader()).default : undefined)
if (!src && filename) {
  console.warn(`[Photo] image not found in src/assets/images: ${filename}`)
}
const resolvedAlt = alt ?? (filename ? await photoAlt(filename) : '')

// Fall back to the unoptimised original when no image service is available.
//
// `imageService: 'compile'` gives Astro's build-time sharp service to prerendered
// routes only. The CMS preview re-renders a region through /tina-island, the
// site's one on-demand route, where there is no service — so <Image> emits the
// generic /_image endpoint URL, which a static deploy never generates. It 404s,
// and the preview shows broken images while the live page is perfect.
//
// This tests for that outcome rather than for the context. Detecting the island
// directly isn't possible: it renders through Astro's Container API without a
// request, so `Astro.url` is not the island's URL. Asking what `getImage` would
// produce works wherever the component is used, including anywhere on-demand we
// add later. `import.meta.env.PROD` keeps dev on the normal path — dev serves
// /_image happily, and we want dev exercising what production does.
//
// The original is bigger than the WebP a live page serves, which is the right
// trade for a preview one editor sees at a time. prune-dist keeps those files
// when the editor ships; see the note there.
const built = src ? await getImage({ src, widths, sizes, format }) : undefined
const unoptimised = import.meta.env.PROD && built?.src.startsWith('/_image') ? src : undefined
---

{
  src &&
    (unoptimised ? (
      <img
        src={unoptimised.src}
        alt={resolvedAlt}
        class={className}
        width={unoptimised.width}
        height={unoptimised.height}
        loading={loading}
        decoding="async"
      />
    ) : (
      <Image
        src={src}
        alt={resolvedAlt}
        class={className}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        format={format}
      />
    ))
}

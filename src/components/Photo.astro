---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { imageLoader } from '../lib/images'

// Thin wrapper around Astro's <Image>. Provide EITHER:
//   • `image` — a resolved ImageMetadata (e.g. a content-collection image() field), or
//   • `filename` — a name in src/assets/images, resolved via import.meta.glob.
// Emits an optimized, responsive WebP <img> with intrinsic width/height (no
// layout shift). Renders nothing if a filename can't be resolved, so callers
// don't need their own fallback. Astro caps generated widths at the source
// width, so oversized `widths` are harmless.

type Props = {
  image?: ImageMetadata
  filename?: string
  alt: string
  class?: string
  widths?: number[]
  sizes?: string
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
  format?: 'webp' | 'avif' | 'png' | 'jpeg'
}

const {
  image,
  filename,
  alt,
  class: className,
  widths = [480, 960, 1440],
  sizes = '(max-width: 1100px) 100vw, 1100px',
  loading = 'lazy',
  fetchpriority,
  format = 'webp',
} = Astro.props

const loader = !image && filename ? imageLoader(filename) : undefined
const src = image ?? loader?.()
if (!src && filename) {
  console.warn(`[Photo] image not found in src/assets/images: ${filename}`)
}
---

{
  src && (
    <Image
      src={src}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      format={format}
    />
  )
}

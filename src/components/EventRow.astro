---
import type { CalendarEvent } from '../lib/events/types'
import { fmtDay, fmtDate, fmtTime } from '../lib/events/format'
import { venueLabel } from '../lib/events/place'
import { isWebUrl, resolveHref } from '../lib/url'

// One row in an event list: a date chip, the title + category/time/location, and
// a "Details" link. Shared by the full <EventsBoard> and the compact youth feed.
type Props = { event: CalendarEvent }

const { event } = Astro.props
const start = new Date(event.start)
const external = isWebUrl(event.url)
// Only when it isn't the church: Planning Center stamps the full campus address
// onto nearly every event, and repeated down a list it drowns the few that are
// genuinely somewhere else.
const venue = venueLabel(event.location)
---

<article class="event-row">
  <div class="event-row__date-chip">
    <span class="event-row__dow">{fmtDay(start)}</span>
    <span class="event-row__dnum">{fmtDate(start)}</span>
  </div>

  <div class="event-row__main">
    <div class="event-row__title">{event.title}</div>
    <div class="event-row__meta">
      <span class="tag">{event.category}</span>
      <span>
        {event.allDay ? 'All day' : fmtTime(start)}
        {venue ? ` · ${venue}` : ''}
      </span>
    </div>
  </div>

  <div class="event-row__cta">
    <a
      class="btn btn--quiet btn--sm"
      href={resolveHref(event.url)}
      rel={external ? 'noopener' : undefined}
      target={external ? '_blank' : undefined}
    >
      Details <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

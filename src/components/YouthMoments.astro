---
import { resolveHref } from '../lib/url'

// The big, recurring tentpoles of the youth program (from the `youthMoments`
// collection). Featured moments render as large cards for special attention;
// the rest fall into a compact list beneath them.
type Moment = {
  title: string
  when?: string
  blurb: string
  link?: { label?: string; href?: string }
  featured: boolean
}

type Props = {
  /** Visual-editor block marker; see src/lib/tina/block-field.ts. */
  tinaField?: string
  moments: Moment[]
  eyebrow?: string
  heading?: string
}

const { moments, eyebrow = 'Through the year', heading = 'Big moments worth planning around', tinaField } = Astro.props

const featured = moments.filter((m) => m.featured)
const rest = moments.filter((m) => !m.featured)
---

<section class="section youth-moments" data-reveal data-tina-field={tinaField}>
  <div class="youth-moments__head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {heading && <h2 class="youth-moments__heading">{heading}</h2>}
  </div>

  {
    featured.length > 0 && (
      <div class="moment-cards">
        {featured.map((m) => (
          <article class="moment-card">
            <div class="moment-card__body">
              {m.when && <p class="moment-card__cadence">{m.when}</p>}
              <h3 class="moment-card__title">{m.title}</h3>
              <p class="moment-card__blurb">{m.blurb}</p>
              {m.link?.href && (
                <p class="moment-card__cta">
                  <a href={resolveHref(m.link.href)}>{m.link.label} →</a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    )
  }

  {
    rest.length > 0 && (
      <ul class="moment-list">
        {rest.map((m) => (
          <li class="moment-list__item">
            <div class="moment-list__head">
              <span class="moment-list__title">{m.title}</span>
              {m.when && <span class="moment-list__cadence">{m.when}</span>}
            </div>
            <p class="moment-list__blurb">{m.blurb}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>

---
// The next seven days, grouped by day, in a single panel.
//
// One bordered surface with hairline dividers rather than a stack of cards:
// "this week" is one answer to one question, and rendering it as N separate
// tiles makes a short week look like a sparse grid instead of a full answer.
// Days with nothing on are left out rather than shown empty.

import type { CalendarEvent } from '../../lib/events/types'
import { fmtDay, fmtDate, fmtTime } from '../../lib/events/format'
import { pacificDay } from '../../lib/events/logic'
import { venueLabel } from '../../lib/events/place'

type Props = { events: CalendarEvent[] }

const { events } = Astro.props

// Keyed on the church-local calendar day so the grouping matches what a reader
// would call "Monday", not what the build host's clock would.
const days = new Map<string, CalendarEvent[]>()
for (const e of events) {
  const key = pacificDay(new Date(e.start))
  days.set(key, [...(days.get(key) ?? []), e])
}
---

<div class="week-panel">
  {
    [...days.entries()].map(([, list]) => {
      const first = new Date(list[0].start)
      return (
        <div class="week-panel__day">
          <div class="week-panel__when">
            <span class="week-panel__dow">{fmtDay(first)}</span>
            <span class="week-panel__date">{fmtDate(first)}</span>
          </div>

          <ul class="week-panel__events">
            {list.map((e) => {
              const venue = venueLabel(e.location)
              const external = e.url.startsWith('http')
              return (
                <li class="week-panel__event">
                  <span class="week-panel__time">{e.allDay ? 'All day' : fmtTime(new Date(e.start))}</span>
                  <span class="week-panel__what">
                    <a
                      class="week-panel__title"
                      href={e.url}
                      rel={external ? 'noopener' : undefined}
                      target={external ? '_blank' : undefined}
                    >
                      {e.title}
                    </a>
                    {venue && <span class="week-panel__venue">{venue}</span>}
                  </span>
                </li>
              )
            })}
          </ul>
        </div>
      )
    })
  }
</div>

---
// The recurring "eyebrow + heading" block that opens most sections.
// Composable: drop it inside any <section>. A trailing lede/body stays inline.
// Both parts guard themselves, so callers pass what they have unconditionally.

type Props = {
  eyebrow?: string
  heading?: string
}

const { eyebrow, heading }: Props = Astro.props
---

{eyebrow && <p class="eyebrow">{eyebrow}</p>}
{heading && <h2>{heading}</h2>}

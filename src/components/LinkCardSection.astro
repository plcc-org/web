---
import { withBase } from '../lib/url'

export type LinkCardItem = {
  href: string
  title: string
  meta: string
}

type Props = {
  heading?: string
  links: LinkCardItem[]
}

const { heading = 'Start here', links } = Astro.props
---

<section class="section">
  <h2>{heading}</h2>

  <div class="link-grid">
    {
      links.map((link) => (
        <a href={withBase(link.href)} class="link-card">
          <strong>{link.title}</strong>
          <div class="link-card__meta">{link.meta}</div>
        </a>
      ))
    }
  </div>
</section>

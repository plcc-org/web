---
import type { LinkCardItem } from '../data/startHereLinks'

type Props = {
  heading?: string
  links: LinkCardItem[]
}

const { heading = 'Start here', links } = Astro.props
---

<section class="section">
  <h2>{heading}</h2>

  <div class="link-grid">
    {
      links.map((link) => (
        <a href={`${import.meta.env.BASE_URL}${link.href.replace(/^\//, '')}`} class="link-card">
          <strong>{link.title}</strong>
          <div class="link-card__meta">{link.meta}</div>
        </a>
      ))
    }
  </div>
</section>
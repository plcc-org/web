---
import { resolveHref } from '../lib/url'

export type LinkCardItem = {
  href: string
  title: string
  meta: string
}

type Props = {
  /** Visual-editor block marker; see src/lib/tina/block-field.ts. */
  tinaField?: string
  heading?: string
  links: LinkCardItem[]
  reveal?: boolean
}

// The CMS sends '' for an empty text field, not undefined — a default
// parameter alone lets that through and renders a bare <h2>.
const { heading: headingProp, links, reveal = false, tinaField } = Astro.props
const heading = headingProp?.trim() || 'Start here'

// Pick a column count from the item count: as many columns as cards (capped at
// 4 so cards don't get too narrow), except 5 splits 3+2 to avoid a lone 4+1
// orphan. The 860px/560px overrides below step everything down to 2 then 1.
const cols = links.length === 5 ? 3 : Math.min(links.length, 4)
---

<section {...reveal && { 'data-reveal': true }} data-tina-field={tinaField}>
  <h2>{heading}</h2>

  <div class:list={['link-grid', reveal && 'reveal-staggered']} style={`--link-cols:${cols}`}>
    {
      links.map((link) => (
        <a href={resolveHref(link.href)} class="link-card">
          <strong>{link.title}</strong>
          <div class="link-card__meta">{link.meta}</div>
        </a>
      ))
    }
  </div>
</section>

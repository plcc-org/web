---
import type { ImageMetadata } from 'astro'
import Split from '../../Split.astro'
import Hero from '../../Hero.astro'
import Photo from '../../Photo.astro'
import { imageFromRef } from '../../../lib/images'
import { altFor } from '../../../lib/photos'
import { renderInline } from '../../../lib/markdown'
import { resolveHref } from '../../../lib/url'

// The page hero, from a CMS page's frontmatter `hero`. Every shape puts the page
// title in a single, real <h1> — that guarantee is why the hero lives in
// frontmatter rather than the block palette.
//
// `variant` names which shape the editor chose (tina/templates.mjs); PageBody
// derives it from the GraphQL `__typename`. The four used to be implicit — a
// photo hero was "the one where `image` happened to be set" — so a page could
// half-declare itself and render as something the editor didn't intend:
//
//   photo      a portrait Split, page title alongside          (the default)
//   plain      a text-only header, no photo
//   wordmark   a programme logo standing in for the title, hidden <h1> behind it
//   cinematic  the full-bleed drifting photo stack (the home page)
//
// Images (hero photos and the wordmark) resolve through imageFromRef — the same
// nesting-agnostic registry the block wrappers use — so a stored path works
// whether the page is flat or nested.
type HeroPhoto = { image?: string; alt?: string }
type Props = {
  variant?: 'photo' | 'plain' | 'wordmark' | 'cinematic'
  image?: string
  alt?: string
  photos?: HeroPhoto[]
  eyebrow?: string
  title: string
  subhead?: string
  lede?: string
  logo?: string
  logoAlt?: string
  buttonLabel?: string
  buttonHref?: string
  flush?: boolean
  /** Visual-editor marker; see src/lib/tina/block-field.ts. Absent on hand-built pages. */
  tinaField?: string
}
const {
  variant = 'photo',
  image,
  alt,
  photos = [],
  eyebrow,
  title,
  subhead,
  lede,
  logo,
  logoAlt,
  buttonLabel,
  buttonHref,
  flush,
  tinaField,
} = Astro.props

const resolve = async (ref?: string) =>
  ref ? ((await imageFromRef(ref)?.())?.default as ImageMetadata | undefined) : undefined

const heroImg = await resolve(image)
const logoImg = await resolve(logo)
const heroAlt = await altFor(alt, image)

// Drop any pane whose upload can't be resolved, rather than rendering a gap.
// `photos ?? []`, not just the destructuring default: every hero carries the
// field now that they share one flat shape, and a non-cinematic one arrives as
// an explicit null, which a default parameter doesn't catch.
const panes: { image: ImageMetadata; alt: string }[] = []
for (const p of photos ?? []) {
  const resolved = await resolve(p.image)
  if (resolved) panes.push({ image: resolved, alt: await altFor(p.alt, p.image) })
}

// Which shape renders is the variant the editor chose, never an inference from
// which optional fields happen to be filled in — that inference is what the
// variant select replaced. Concretely: a leftover `image` on a plain hero stays
// ignored (as src/content.config.ts promises), a photo hero missing its photo
// falls back to the text-only header (a preview-only state — zod rejects it at
// build, and the form says so), and a wordmark hero keeps its logo standing in
// for the heading whether or not it also has a photo.
const cinematic = variant === 'cinematic' && panes.length > 0
const split = (variant === 'photo' || variant === 'wordmark') && heroImg
const wordmarkLogo = variant === 'wordmark' ? logoImg : undefined
---

{
  cinematic ? (
    <Hero images={panes} eyebrow={eyebrow} title={title} subhead={subhead} tinaField={tinaField}>
      {buttonHref && (
        <a class="btn" href={resolveHref(buttonHref)}>
          {buttonLabel || 'Learn more'}
        </a>
      )}
    </Hero>
  ) : split ? (
    <Split
      class:list={['to-full', flush && 'is-flush']}
      image={heroImg}
      alt={heroAlt}
      reverse
      tone="sand"
      eyebrow={eyebrow}
      tinaField={tinaField}
    >
      {wordmarkLogo ? (
        <Fragment>
          <Photo
            image={wordmarkLogo}
            alt={logoAlt || ''}
            class="page-hero__logo"
            loading="eager"
            fetchpriority="high"
            widths={[340, 680]}
            sizes="(max-width: 600px) 70vw, 340px"
          />
          {/* A real <h1> for the document outline, visually replaced by the logo above. */}
          <h1 class="visually-hidden">{title}</h1>
        </Fragment>
      ) : (
        <h1 class="display">{title}</h1>
      )}
      {subhead && <p class="subhead">{subhead}</p>}
      {lede && <p class="lede" set:html={renderInline(lede)} />}
      {buttonHref && (
        <p>
          <a class="btn" href={resolveHref(buttonHref)}>
            {buttonLabel || 'Learn more'}
          </a>
        </p>
      )}
    </Split>
  ) : (
    <header class="section page-intro" data-tina-field={tinaField}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {wordmarkLogo ? (
        <Fragment>
          <Photo
            image={wordmarkLogo}
            alt={logoAlt || ''}
            class="page-hero__logo"
            loading="eager"
            fetchpriority="high"
            widths={[340, 680]}
            sizes="(max-width: 600px) 70vw, 340px"
          />
          <h1 class="visually-hidden">{title}</h1>
        </Fragment>
      ) : (
        <h1 class="display">{title}</h1>
      )}
      {subhead && <p class="subhead">{subhead}</p>}
      {lede && <p class="lede" set:html={renderInline(lede)} />}
      {buttonHref && (
        <p>
          <a class="btn" href={resolveHref(buttonHref)}>
            {buttonLabel || 'Learn more'}
          </a>
        </p>
      )}
    </header>
  )
}

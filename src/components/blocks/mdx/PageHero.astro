---
import type { ImageMetadata } from 'astro'
import Split from '../../Split.astro'
import Photo from '../../Photo.astro'
import { imageFromRef } from '../../../lib/images'
import { renderInline } from '../../../lib/markdown'
import { resolveHref } from '../../../lib/url'

// The page hero, from a CMS page's frontmatter `hero`. Renders the site's
// reversed sand Split with the page H1 + lede — guaranteeing every CMS page has
// a single, real <h1>. Images (the hero photo and an optional wordmark logo)
// resolve through imageFromRef — the same nesting-agnostic registry the block
// wrappers use — so a fixed "../../assets/images/…" path works whether the page
// is flat or nested. When a logo is present it stands in for the visible title
// (a wordmark); the <h1> text is kept for the document outline but hidden.
type Props = {
  image?: string
  alt?: string
  eyebrow?: string
  title: string
  subhead?: string
  lede?: string
  logo?: string
  logoAlt?: string
  buttonLabel?: string
  buttonHref?: string
  flush?: boolean
}
const { image, alt, eyebrow, title, subhead, lede, logo, logoAlt, buttonLabel, buttonHref, flush } = Astro.props
const heroImg = image ? ((await imageFromRef(image)?.())?.default as ImageMetadata | undefined) : undefined
const logoImg = logo ? ((await imageFromRef(logo)?.())?.default as ImageMetadata | undefined) : undefined
---

{
  heroImg ? (
    <Split
      class:list={['to-full', flush && 'is-flush']}
      image={heroImg}
      alt={alt}
      reverse
      tone="sand"
      eyebrow={eyebrow}
    >
      {logoImg ? (
        <Fragment>
          <Photo
            image={logoImg}
            alt={logoAlt || ''}
            class="page-hero__logo"
            loading="eager"
            fetchpriority="high"
            widths={[340, 680]}
            sizes="(max-width: 600px) 70vw, 340px"
          />
          {/* A real <h1> for the document outline, visually replaced by the logo above. */}
          <h1 class="visually-hidden">{title}</h1>
        </Fragment>
      ) : (
        <h1 class="display">{title}</h1>
      )}
      {subhead && <p class="subhead">{subhead}</p>}
      {lede && <p class="lede" set:html={renderInline(lede)} />}
      {buttonHref && (
        <p>
          <a class="btn" href={resolveHref(buttonHref)}>
            {buttonLabel || 'Learn more'}
          </a>
        </p>
      )}
    </Split>
  ) : (
    <header class="section page-intro">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="display">{title}</h1>
      {subhead && <p class="subhead">{subhead}</p>}
      {lede && <p class="lede" set:html={renderInline(lede)} />}
      {buttonHref && (
        <p>
          <a class="btn" href={resolveHref(buttonHref)}>
            {buttonLabel || 'Learn more'}
          </a>
        </p>
      )}
    </header>
  )
}

---
import type { ImageMetadata } from 'astro'
import Photo from '../../Photo.astro'
import { imageFromRef } from '../../../lib/images'

// MDX wrapper for the Aside block — a tinted two-column note: formatted prose
// (the MDX children) beside an optional small logo. Generalizes the Beliefs
// "creed-note"; stacks on mobile.
type Props = { eyebrow?: string; logo?: string; logoAlt?: string }
const { eyebrow, logo, logoAlt } = Astro.props
const logoImg = logo ? ((await imageFromRef(logo)?.())?.default as ImageMetadata | undefined) : undefined
---

<section class="section" data-reveal>
  <div class:list={['aside-note', !logoImg && 'aside-note--solo']}>
    <div class="aside-note__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <slot />
    </div>
    {
      logoImg && (
        <Photo
          image={logoImg}
          alt={logoAlt || ''}
          class="aside-note__logo"
          widths={[260, 520]}
          sizes="(max-width: 640px) 60vw, 220px"
        />
      )
    }
  </div>
</section>

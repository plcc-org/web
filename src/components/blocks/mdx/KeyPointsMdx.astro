---
import SectionHeader from '../../SectionHeader.astro'
import AccentList from '../../AccentList.astro'

// MDX wrapper for the Key points block — a moss-accented grid of titled point
// cards (the Beliefs tenets / Covenant emphases treatment), with an optional
// eyebrow + heading. `columns` arrives from Keystatic as a string select.
type Props = {
  eyebrow?: string
  heading?: string
  columns?: number | string
  items?: { title: string; body: string }[]
}
const { eyebrow, heading, columns, items = [] } = Astro.props
const cols = Number(columns) === 3 ? 3 : 2
---

<section class="section" data-reveal>
  {(eyebrow || heading) && <SectionHeader eyebrow={eyebrow || undefined} heading={heading || undefined} />}
  <AccentList items={items} columns={cols} />
</section>

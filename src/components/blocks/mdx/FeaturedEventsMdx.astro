---
import EventRow from '../../EventRow.astro'
import { getUpcomingEvents } from '../../../lib/events/provider'
import type { EventCategory } from '../../../lib/events/types'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

// Block adapter for the Featured events block — a short list of upcoming events
// pulled from the live events feed (Church Center in prod, curated fallback).
// `category` is an EventCategory or 'all'; the block renders nothing if no
// matching events are upcoming.
type Props = { heading?: string; category?: EventCategory | 'all'; count?: number } & BlockProps
const { heading, category = 'all', count = 3 } = Astro.props

const events = (await getUpcomingEvents()).filter((e) => category === 'all' || e.category === category).slice(0, count)
---

{events.length > 0 && (
  <section data-reveal data-tina-field={blockField(Astro.props)}>
    {heading && <h2>{heading}</h2>}
    <ul class="event-list" role="list">
      {events.map((e) => (
        <li>
          <EventRow event={e} />
        </li>
      ))}
    </ul>
  </section>
)}

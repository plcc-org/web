---
import SectionHeader from '../../SectionHeader.astro'

// MDX wrapper for a titled text section: an optional eyebrow + heading, then the
// component's prose, in the site's section/measure rhythm. This is what gives
// free-standing copy the correct spacing (and an eyebrow) — versus bare
// top-level Markdown, which renders outside the section grid.
type Props = { eyebrow?: string; heading?: string }
const { eyebrow, heading } = Astro.props
---

<section class="section" data-reveal>
  {(eyebrow || heading) && <SectionHeader eyebrow={eyebrow || undefined} heading={heading || undefined} />}
  <div class="measure"><slot /></div>
</section>

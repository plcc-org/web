---
import Photo from '../../Photo.astro'
import { imageFromRef } from '../../../lib/images'

// MDX wrapper for a single framed, captioned photo.
type Props = { image?: string; alt: string; caption?: string }
const { image, alt, caption } = Astro.props
const resolved = image ? (await imageFromRef(image)?.())?.default : undefined
---

<section class="section" data-reveal>
  <figure class="media">
    <Photo image={resolved} alt={alt} class="media__img media__img--cover" />
    {caption && <figcaption class="media__caption">{caption}</figcaption>}
  </figure>
</section>

---
import Band from '../../Band.astro'
import { withBase } from '../../../lib/url'

// MDX wrapper for the call-to-action band — a tonal closing band with the
// component's MDX children and an optional button.
type Props = {
  tone?: 'forest' | 'sand' | 'paper'
  eyebrow?: string
  heading?: string
  buttonLabel?: string
  buttonHref?: string
  flush?: boolean
}
const { tone = 'forest', eyebrow, heading, buttonLabel, buttonHref, flush } = Astro.props
const resolve = (href: string) => (/^(https?:|mailto:|#)/.test(href) ? href : withBase(href))
---

<Band tone={tone} narrow flush={flush} eyebrow={eyebrow} heading={heading} reveal>
  <slot />
  {
    buttonHref && (
      <p>
        <a class="btn btn--ghost" href={resolve(buttonHref)}>
          {buttonLabel || 'Learn more'}
        </a>
      </p>
    )
  }
</Band>

---
import CardRow from '../../CardRow.astro'
import SectionHeader from '../../SectionHeader.astro'
import { renderInline } from '../../../lib/markdown'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

// MDX wrapper for the Card row block — a row of titled cards (Markdown bodies),
// with an optional eyebrow + heading + lead line above them and an optional cap
// on how many cards sit on a row. Keeping the heading/intro in the same block
// (rather than a separate Rich text block) keeps them tight to the cards.
type Props = {
  eyebrow?: string
  heading?: string
  intro?: string
  columns?: number | string
  large?: boolean
  cards?: { title: string; body: string; href?: string; linkLabel?: string }[]
} & BlockProps
const { eyebrow, heading, intro, columns, large, cards = [] } = Astro.props
---

<section class="section" data-reveal data-tina-field={blockField(Astro.props)}>
  {(eyebrow || heading) && <SectionHeader eyebrow={eyebrow || undefined} heading={heading || undefined} />}
  {intro && <p class="measure" set:html={renderInline(intro)} />}
  <CardRow items={cards} columns={columns} large={large} />
</section>

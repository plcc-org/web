---
import type { ImageMetadata } from 'astro'
import MomentsSection from '../../MomentsSection.astro'
import { imageFromRef } from '../../../lib/images'

// MDX wrapper for the Photo band block. Each photo's uploaded reference resolves
// through imageFromRef to optimized ImageMetadata, then renders via the existing
// staggered MomentsSection band.
type Props = {
  photos?: { image: string; alt: string }[]
  heading?: string
  eyebrow?: string
}
const { photos = [], heading, eyebrow } = Astro.props

const images: { image: ImageMetadata; alt: string }[] = []
for (const p of photos) {
  const mod = p.image ? await imageFromRef(p.image)?.() : undefined
  if (mod) images.push({ image: mod.default, alt: p.alt })
}
---

<MomentsSection images={images} heading={heading || null} eyebrow={eyebrow || null} sectionClass="to-wide" reveal />

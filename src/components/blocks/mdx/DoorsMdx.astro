---
import SectionHeader from '../../SectionHeader.astro'
import DoorCard from '../../DoorCard.astro'
import { getCollection } from 'astro:content'

// MDX wrapper for the Neighbor doors block — the "common starting points" cards,
// pulled from the shared `neighborDoors` collection (sorted by order). Optional
// eyebrow/heading/intro; `count` limits how many doors show (default: all).
type Props = { eyebrow?: string; heading?: string; intro?: string; count?: number }
const { eyebrow, heading, intro, count } = Astro.props

let doors = (await getCollection('neighborDoors')).sort((a, b) => a.data.order - b.data.order)
if (count && count > 0) doors = doors.slice(0, count)
---

<section class="section">
  {(eyebrow || heading) && <SectionHeader eyebrow={eyebrow || undefined} heading={heading || undefined} />}
  {intro && <p class="measure">{intro}</p>}
  <div class="doors" aria-label="Ways to connect with Pine Lake">
    {doors.map((d) => <DoorCard {...d.data} />)}
  </div>
</section>

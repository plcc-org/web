---
import type { ImageMetadata } from 'astro'
import SectionHeader from '../../SectionHeader.astro'
import Photo from '../../Photo.astro'
import { imageFromRef } from '../../../lib/images'
import { renderMarkdown } from '../../../lib/markdown'
import { resolveHref } from '../../../lib/url'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

// MDX wrapper for the Logo cards block — a row of cards, each topped by a
// program/partner logo, with a short Markdown body and an optional link (the
// "Pine Lake Kids / Youth" card grid). Each logo resolves through imageFromRef.
type Card = { image?: string; alt: string; body?: string; linkLabel?: string; href?: string }
type Props = { eyebrow?: string; heading?: string; cards?: Card[] } & BlockProps
const { eyebrow, heading, cards = [] } = Astro.props

const items: { image?: ImageMetadata; alt: string; body?: string; linkLabel?: string; href?: string }[] = []
for (const c of cards) {
  const mod = c.image ? await imageFromRef(c.image)?.() : undefined
  items.push({ image: mod?.default, alt: c.alt, body: c.body, linkLabel: c.linkLabel, href: c.href })
}
---

<section class="section" data-reveal data-tina-field={blockField(Astro.props)}>
  <SectionHeader eyebrow={eyebrow} heading={heading} />
  <div class="card-grid">
    {
      items.map((c) => (
        <div class="card">
          {c.image && (
            <Photo
              image={c.image}
              alt={c.alt}
              class="logo-card__logo"
              widths={[240, 480, 720]}
              sizes="(max-width: 768px) 80vw, 240px"
            />
          )}
          {c.body && <Fragment set:html={renderMarkdown(c.body)} />}
          {/* href alone is enough — the label falls back, matching CardRow's
              rule so the two card blocks behave alike. */}
          {c.href && (
            <p>
              <a href={resolveHref(c.href)}>{c.linkLabel || 'Learn more'} →</a>
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>

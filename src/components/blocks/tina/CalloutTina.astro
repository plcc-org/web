---
import Callout from '../../Callout.astro'
import TinaChildren from './TinaChildren.astro'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

// Tina counterpart of the Callout block. The site component takes its prose in the
// default slot; here it arrives as a `body` rich-text tree on the block.
type Props = { heading?: string; body?: unknown } & BlockProps
const { heading, body } = Astro.props
---

<Callout tinaField={blockField(Astro.props)} heading={heading}>
  <TinaChildren content={body as never} />
</Callout>

---
import Band from '../../Band.astro'
import { resolveHref } from '../../../lib/url'
import TinaChildren from './TinaChildren.astro'

// The Banner block: a tonal closing band with an optional button. Its prose
// arrives as a `children` rich-text tree on the node's props, not through a slot.
type Props = {
  tone?: 'forest' | 'sand' | 'paper'
  eyebrow?: string
  heading?: string
  buttonLabel?: string
  buttonHref?: string
  flush?: boolean
  children?: unknown
}
const { tone = 'forest', eyebrow, heading, buttonLabel, buttonHref, flush, children } = Astro.props
---

<Band tone={tone} narrow flush={flush} eyebrow={eyebrow} heading={heading} reveal>
  <TinaChildren content={children as never} />
  {
    buttonHref && (
      <p>
        <a class="btn btn--ghost" href={resolveHref(buttonHref)}>
          {buttonLabel || 'Learn more'}
        </a>
      </p>
    )
  }
</Band>

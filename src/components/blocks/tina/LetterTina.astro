---
import type { ImageMetadata } from 'astro'
import Letter from '../../Letter.astro'
import { imageFromRef } from '../../../lib/images'
import TinaChildren from './TinaChildren.astro'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

// The Letter block: flowing prose beside an optional portrait, with a signature.
type Props = {
  image?: string
  alt?: string
  signoffName?: string
  signoffRole?: string
  children?: unknown
} & BlockProps
const { image, alt, signoffName, signoffRole, children } = Astro.props
const img = image ? ((await imageFromRef(image)?.())?.default as ImageMetadata | undefined) : undefined
---

<section class="to-wide" data-reveal data-tina-field={blockField(Astro.props)}>
  <Letter image={img} alt={alt} signoffName={signoffName} signoffRole={signoffRole}>
    <TinaChildren content={children as never} />
  </Letter>
</section>

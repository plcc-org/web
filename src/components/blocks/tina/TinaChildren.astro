---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro'
import type { TinaRichTextContent } from '@tinacms/astro/types'

// Renders a wrapper block's body. Under MDX these arrive through `<slot />`;
// through Tina they arrive as a `children` rich-text tree on the node's props,
// so wrapper adapters delegate here instead of using a slot.
//
// No custom components are passed down: every wrapper in src/content/pages
// contains prose only, never another block. Nesting one would need a shared
// component map, which the adapters can't import without a cycle.
type Props = { content?: TinaRichTextContent }
const { content } = Astro.props
---

{content && <TinaMarkdown content={content} />}

---
import Band from '../../Band.astro'
import { resolveHref } from '../../../lib/url'
import TinaChildren from './TinaChildren.astro'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

// The Closing banner: the dark band that ends a page against the footer. Its
// prose arrives as a `children` rich-text tree on the node's props, not through
// a slot.
//
// Tone, flush and alignment are fixed here rather than offered as fields. A
// closing band is one thing and always looks like it — leaving them adjustable
// only invited a page to get it wrong, which is what happened twice while
// `flush` was a tickbox.
type Props = {
  eyebrow?: string
  heading?: string
  buttonLabel?: string
  buttonHref?: string
  children?: unknown
} & BlockProps
const { eyebrow, heading, buttonLabel, buttonHref, children } = Astro.props
---

<Band tinaField={blockField(Astro.props)} tone="forest" centered flush eyebrow={eyebrow} heading={heading} reveal>
  <TinaChildren content={children as never} />
  {
    buttonHref && (
      <a class="btn" href={resolveHref(buttonHref)}>
        {buttonLabel || 'Learn more'}
      </a>
    )
  }
</Band>

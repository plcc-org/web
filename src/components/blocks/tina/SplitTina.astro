---
import Split from '../../Split.astro'
import { imageFromRef } from '../../../lib/images'
import { altFor } from '../../../lib/photos'
import { resolveHref } from '../../../lib/url'
import TinaChildren from './TinaChildren.astro'
import { blockField, type BlockProps } from '../../../lib/tina/block-field'

type Props = {
  image?: string
  alt?: string
  reverse?: boolean
  tone?: 'paper' | 'sand' | 'forest'
  eyebrow?: string
  heading?: string
  buttonLabel?: string
  buttonHref?: string
  children?: unknown
} & BlockProps
const { image, alt, reverse = false, tone = 'sand', eyebrow, heading, buttonLabel, buttonHref, children } = Astro.props
const resolved = image ? (await imageFromRef(image)?.())?.default : undefined
---

<Split
  tinaField={blockField(Astro.props)}
  class="to-full"
  image={resolved}
  alt={await altFor(alt, image)}
  reverse={reverse}
  tone={tone}
  eyebrow={eyebrow}
  heading={heading}
  reveal
>
  <TinaChildren content={children as never} />
  {
    buttonHref && (
      <p>
        <a class="btn btn--ghost" href={resolveHref(buttonHref)}>
          {buttonLabel || 'Learn more'}
        </a>
      </p>
    )
  }
</Split>

---
import type { CollectionEntry } from 'astro:content'
import Split from '../Split.astro'
import CardRow from '../CardRow.astro'
import Callout from '../Callout.astro'
import MomentsSection from '../MomentsSection.astro'
import LinkCardSection from '../LinkCardSection.astro'
import Band from '../Band.astro'
import Photo from '../Photo.astro'
import { renderMarkdown, renderInline } from '../../lib/markdown'
import { withBase } from '../../lib/url'

// Renders a CMS page's ordered block list. Each block maps 1:1 to an existing
// site component; the design system keeps every block on-brand by construction.
// The block shape ({ discriminant, value }) mirrors Keystatic's serialization
// (see the `pages` collection in src/content.config.ts).
type Block = CollectionEntry<'pages'>['data']['blocks'][number]
type Props = { blocks: Block[] }
const { blocks } = Astro.props

const resolveHref = (href: string) => (/^(https?:|mailto:|#)/.test(href) ? href : withBase(href))

// A full-bleed block that ends the page sits flush against the footer (the
// site's documented closing convention).
const FULL_BLEED = new Set(['pageHeader', 'split'])
---

{
  blocks.map((block, i) => {
    const isLast = i === blocks.length - 1
    const flush = isLast && FULL_BLEED.has(block.discriminant) ? 'is-flush' : undefined

    if (block.discriminant === 'pageHeader') {
      const v = block.value
      return (
        <Split
          class:list={['to-full', flush]}
          image={v.image}
          alt={v.alt}
          reverse
          tone="sand"
          eyebrow={v.eyebrow || undefined}
        >
          <h1 class="display">{v.title}</h1>
          <p class="lede" set:html={renderInline(v.lede)} />
        </Split>
      )
    }

    if (block.discriminant === 'richText') {
      const v = block.value
      return (
        <section class="section">
          {v.eyebrow && <p class="eyebrow">{v.eyebrow}</p>}
          <div class="measure" set:html={renderMarkdown(v.body)} />
        </section>
      )
    }

    if (block.discriminant === 'split') {
      const v = block.value
      return (
        <Split
          class:list={['to-full', flush]}
          image={v.image}
          alt={v.alt}
          reverse={v.reverse}
          tone={v.tone}
          eyebrow={v.eyebrow || undefined}
          heading={v.heading || undefined}
        >
          <div set:html={renderMarkdown(v.body)} />
        </Split>
      )
    }

    if (block.discriminant === 'captionedPhoto') {
      const v = block.value
      return (
        <section class="section">
          <figure class="media">
            <Photo image={v.image} alt={v.alt} class="media__img media__img--cover" />
            {v.caption && <figcaption class="media__caption">{v.caption}</figcaption>}
          </figure>
        </section>
      )
    }

    if (block.discriminant === 'cardRow') {
      return (
        <section class="section">
          <CardRow items={block.value.cards} />
        </section>
      )
    }

    if (block.discriminant === 'callout') {
      return <Callout heading={block.value.heading || undefined} body={block.value.body} />
    }

    if (block.discriminant === 'photoBand') {
      const v = block.value
      return (
        <MomentsSection
          images={v.photos}
          heading={v.heading || null}
          eyebrow={v.eyebrow || null}
          sectionClass="to-wide"
        />
      )
    }

    if (block.discriminant === 'linkCards') {
      return <LinkCardSection heading={block.value.heading || undefined} links={block.value.links} />
    }

    if (block.discriminant === 'ctaBand') {
      const v = block.value
      return (
        <Band tone={v.tone} narrow flush={isLast} eyebrow={v.eyebrow || undefined} heading={v.heading || undefined}>
          <div set:html={renderMarkdown(v.body)} />
          {v.button?.href && (
            <p>
              <a class="btn btn--ghost" href={resolveHref(v.button.href)}>
                {v.button.label || 'Learn more'}
              </a>
            </p>
          )}
        </Band>
      )
    }

    return null
  })
}

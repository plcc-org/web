---
// A grid of titled "point" cards with a moss accent — the shared treatment
// behind the Beliefs tenets and the Covenant emphases. These are unordered
// sets, so the list is a <ul> with no marker; the moss left-border carries the
// accent. `columns` controls the grid.

type Item = { title: string; body: string }

type Props = {
  items: Item[]
  columns?: 2 | 3
  /**
   * Heading level for the card titles. Defaults to 3, which assumes a section
   * heading sits above the list. A block with no heading of its own must pass
   * 2 — otherwise the page jumps h1 → h3 and the outline has a hole in it.
   */
  headingLevel?: 2 | 3 | 4
}

const { items, columns = 2, headingLevel = 3 } = Astro.props
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4'
---

<ul class:list={['accent-list', `accent-list--${columns}`]}>
  {
    items.map((item) => (
      <li class="accent-card">
        <Heading class="accent-card__title">{item.title}</Heading>
        <p>{item.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .accent-list {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
  }

  /* Two across (beliefs): roomier cards. Three across (covenant): tighter. */
  .accent-list--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .accent-list--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .accent-card {
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-left: 4px solid var(--color-moss);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .accent-list--2 .accent-card {
    padding: clamp(1.5rem, 2.4vw, 2rem);
  }

  .accent-list--3 .accent-card {
    padding: clamp(1.25rem, 2vw, 1.6rem);
  }

  .accent-card__title {
    font-size: var(--text-lg);
  }

  .accent-list--2 .accent-card__title {
    margin: 0 0 0.5rem;
  }

  .accent-list--3 .accent-card__title {
    margin: 0 0 0.4rem;
  }

  .accent-card p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  /* Three across only: slightly smaller, tighter body copy */
  .accent-list--3 .accent-card p {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .accent-list--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .accent-list--2 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .accent-list--3 {
      grid-template-columns: 1fr;
    }
  }
</style>

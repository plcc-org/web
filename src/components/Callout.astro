---
// A bordered "aside" panel — sand background, moss left-accent — for a single
// emphasized point (safety note, a reassurance, an FYI). Rendered as the CMS
// "Callout" block via CalloutTina; content arrives as the default slot, which
// preserves inline markup — lists, <strong>, links.

type Props = {
  /** Visual-editor block marker; see src/lib/tina/block-field.ts. */
  tinaField?: string
  heading?: string
}

const { heading, tinaField } = Astro.props
---

<section class="section section-callout" data-reveal data-tina-field={tinaField}>
  {heading && <h2>{heading}</h2>}
  <slot />
</section>

---
// "What's On" — the whole of /events/.
//
// Three sections, because the calendar holds two different kinds of thing and
// flattening them into one dated list serves neither. "This week" answers what's
// on now. "Coming up" carries the one-offs — the things you'd miss if nobody
// told you. "Regular rhythms" shows each recurring series once, which is both the
// honest shape of the data and the answer to "what is life here actually like?"
//
// The board shows everything in the window. Each row already carries its own
// category tag, so the three sections do the sorting a filter used to.

import PageIntro from './PageIntro.astro'
import Band from './Band.astro'
import ThisWeekPanel from './events/ThisWeekPanel.astro'
import EventCard from './events/EventCard.astro'
import WeekRhythm from './events/WeekRhythm.astro'
import { withBase } from '../lib/url'
import type { buildSections } from '../lib/events/logic'
import type { CalendarEvent } from '../lib/events/types'
import { church } from '../config/church'

type Props = {
  events: CalendarEvent[]
  /** Computed once by the page (which also feeds `rendered` to JSON-LD). */
  sections: ReturnType<typeof buildSections>
}

const { events, sections } = Astro.props
const { thisWeek, oneOffs, rhythms } = sections

const empty = events.length === 0
---

<div class="canvas">
  <PageIntro eyebrow="Services, groups, and community events" title="What’s On">
    <p class="events-place">
      Unless another place is named, everything is at our campus —{' '}
      <a class="events-place__address" href={church.mapUrl} rel="noopener" target="_blank">
        {church.address.street}, {church.address.locality}
      </a>.
    </p>
  </PageIntro>

  {
    empty && (
      <section class="section">
        <h2>Nothing on the calendar</h2>
        <p class="events-empty">There’s nothing dated for the next eight weeks.</p>
        <p>
          <a class="btn btn--ghost" href={withBase('visit/')}>
            Plan a visit <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
    )
  }

  {
    thisWeek.length > 0 && (
      <section class="section">
        <h2>This week</h2>
        <ThisWeekPanel events={thisWeek} />
      </section>
    )
  }

  {
    oneOffs.length > 0 && (
      <section class="section">
        <h2>Coming up</h2>
        <div class="event-grid">
          {oneOffs.map((s) => (
            <EventCard series={s} />
          ))}
        </div>
      </section>
    )
  }

  {
    rhythms.length > 0 && (
      <Band tone="sand" heading="Regular rhythms">
        <WeekRhythm series={rhythms} />
      </Band>
    )
  }
</div>

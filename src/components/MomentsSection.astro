---
import type { ImageMetadata } from 'astro'
import Photo from './Photo.astro'

// A staggered photo band: resolved images, each with its alt (the "Photo band"
// page block resolves both through imageFromRef + altFor).
type ImageItem = { image: ImageMetadata; alt: string }
type Props = {
  /** Visual-editor block marker; see src/lib/tina/block-field.ts. */
  tinaField?: string
  heading?: string | null
  eyebrow?: string | null
  images?: ImageItem[]
  class?: string
  reveal?: boolean
}

const {
  heading = 'Moments from Pine Lake',
  eyebrow = null,
  images = [],
  class: className = 'section',
  reveal = false,
  tinaField,
} = Astro.props

const tiles = images
---

<section data-tina-field={tinaField} {...reveal && { 'data-reveal': true }} class:list={['moments', className]}>
  {
    (eyebrow || heading) && (
      <div class="moments__head">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2 class="moments__heading">{heading}</h2>}
      </div>
    )
  }

  <div class:list={['moments-grid', reveal && 'reveal-staggered']}>
    {
      tiles.map((tile, i) => (
        <figure class:list={['moments__tile', i % 2 === 1 && 'moments__tile--offset']}>
          <Photo
            image={tile.image}
            alt={tile.alt}
            class="moments__img"
            widths={[400, 700, 1080]}
            sizes="(max-width: 768px) 50vw, 33vw"
          />
        </figure>
      ))
    }
  </div>
</section>

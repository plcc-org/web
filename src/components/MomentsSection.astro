---
import type { ImageMetadata } from 'astro'
import Photo from './Photo.astro'

// A staggered photo band. Photos come either as catalog `filename`s (alt looked
// up via the catalog) or as resolved `images` with their own alt (e.g. a
// CMS-uploaded "photo band" page block).
type ImageItem = { image: ImageMetadata; alt: string }
type Props = {
  /** Visual-editor block marker; see src/lib/tina/block-field.ts. */
  tinaField?: string
  heading?: string | null
  eyebrow?: string | null
  photos?: string[]
  images?: ImageItem[]
  sectionClass?: string
  reveal?: boolean
}

const {
  heading = 'Moments from Pine Lake',
  eyebrow = null,
  photos = [],
  images,
  sectionClass = 'section',
  reveal = false,
  tinaField,
} = Astro.props

// Normalize to a single tile list <Photo> can consume either way.
const tiles: Array<{ filename?: string; image?: ImageMetadata; alt?: string }> =
  images ?? photos.map((filename) => ({ filename }))
---

<section data-tina-field={tinaField} {...reveal && { 'data-reveal': true }} class:list={['moments', sectionClass]}>
  {
    (eyebrow || heading) && (
      <div class="moments__head">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2 class="moments__heading">{heading}</h2>}
      </div>
    )
  }

  <div class:list={['moments-grid', reveal && 'reveal-staggered']}>
    {
      tiles.map((tile, i) => (
        <figure class:list={['moments__tile', i % 2 === 1 && 'moments__tile--offset']}>
          <Photo
            filename={tile.filename}
            image={tile.image}
            alt={tile.alt}
            class="moments__img"
            widths={[400, 700, 1080]}
            sizes="(max-width: 768px) 50vw, 33vw"
          />
        </figure>
      ))
    }
  </div>
</section>

---
import { withBase } from '../../lib/url'
import wordmarkUrl from '../../assets/images/Horizontal-Logo-White-on-Transparent.png?url'

// The site's full header: wordmark, the eight-item primary nav, and the hamburger
// that folds it on small screens. Its script lives here rather than in BaseLayout so
// a page rendered with slim chrome (/links/) ships none of it.
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary">
    <div class="site-nav__bar">
      <a href={withBase()} class="site-nav__home" aria-label="Pine Lake Covenant Church — Home">
        <span class="site-nav__home-logo" style={`--logo-wordmark-url: url('${wordmarkUrl}')`} aria-hidden="true"
        ></span>
      </a>
      <button
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="primary-nav-menu"
        aria-label="Open navigation menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <ul class="site-nav__list" id="primary-nav-menu">
      <li><a href={withBase('new/')}>I’m New</a></li>
      <li><a href={withBase('about/')}>About</a></li>
      <li><a href={withBase('families/')}>Families</a></li>
      <li><a href={withBase('neighbors/')}>For Our Neighbors</a></li>
      <li><a href={withBase('church-life/')}>Church Life</a></li>
      <li><a href={withBase('events/')}>What’s On</a></li>
      <li><a href={withBase('messages/')}>Messages</a></li>
      <li><a href={withBase('visit/')} class="btn btn--sm site-nav__cta">Plan a Visit</a></li>
    </ul>
  </nav>
</header>

<script>
  // Frost the sticky header once the page has scrolled past the top.
  const header = document.querySelector<HTMLElement>('.site-header')
  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 8)
  setScrolled()
  window.addEventListener('scroll', setScrolled, { passive: true })

  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle')
  const nav = toggle?.closest('.site-nav')

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false
    toggle.setAttribute('aria-expanded', String(isOpen))
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu')
  })

  // Close when clicking outside the nav
  document.addEventListener('click', (e) => {
    if (nav?.classList.contains('is-open') && !nav.contains(e.target as Node)) {
      nav.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.setAttribute('aria-label', 'Open navigation menu')
    }
  })

  // Close when a nav link is followed
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.setAttribute('aria-label', 'Open navigation menu')
    })
  })
</script>

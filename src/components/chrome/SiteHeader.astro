---
import { withBase } from '../../lib/url'
import wordmarkUrl from '../../assets/images/Horizontal-Logo-White-on-Transparent.png?url'
import SiteBanner from './SiteBanner.astro'

// The site's full header: wordmark, the eight-item primary nav, and the hamburger
// that folds it on small screens. The fold is a native popover, so the menu opens,
// closes on Escape or an outside tap, and reports its state to assistive tech with
// no script at all. The one script here only frosts the bar on scroll; it lives
// here rather than in BaseLayout so a page with slim chrome (/links/) ships none of it.

type Props = {
  /** Offer the Sunday livestream banner (the homepage). */
  livestream?: boolean
}

const { livestream = false } = Astro.props

const links = [
  { path: 'new/', label: 'I’m New' },
  { path: 'about/', label: 'About' },
  { path: 'families/', label: 'Families' },
  { path: 'neighbors/', label: 'For Our Neighbors' },
  { path: 'church-life/', label: 'Church Life' },
  { path: 'events/', label: 'What’s On' },
  { path: 'messages/', label: 'Messages' },
]
const current = (path: string) => (Astro.url.pathname === withBase(path) ? 'page' : undefined)
---

<header class="site-header">
  <SiteBanner livestream={livestream} />
  <nav class="site-nav" aria-label="Primary">
    <div class="site-nav__bar">
      <a href={withBase()} class="site-nav__home" aria-label="Pine Lake Covenant Church — Home">
        <span
          class="site-nav__home-logo"
          style={`--logo-wordmark-url: url('${wordmarkUrl}')`}
          aria-hidden="true"
        ></span>
      </a>
      <button type="button" class="site-nav__toggle" popovertarget="primary-nav-menu" aria-label="Menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <ul class="site-nav__list" id="primary-nav-menu" popover>
      {links.map(({ path, label }) => (
        <li>
          <a href={withBase(path)} aria-current={current(path)}>
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href={withBase('visit/')} class="btn btn--sm site-nav__cta" aria-current={current('visit/')}>
          Plan a Visit
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Frost the sticky header once the page has scrolled past the top.
  const header = document.querySelector<HTMLElement>('.site-header')
  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 8)
  setScrolled()
  window.addEventListener('scroll', setScrolled, { passive: true })
</script>

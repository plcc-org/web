---
// Arms the `[data-reveal]` entrance animations. Its own component so pages rendered
// with slim chrome, which have nothing to reveal, ship no script for it.
---

<script>
  // Scroll reveal — arm only when JS is present and motion is welcome, so
  // content stays visible without JS or under prefers-reduced-motion.
  //
  // Also skipped inside an iframe, and this guard is load-bearing — not just a
  // preference. Two reasons:
  //
  //   1. A reveal starts at opacity 0 and waits for the IntersectionObserver. In
  //      a CMS preview pane that observer never fires for anything below the
  //      fold, so the page body stays invisible and the editor looks broken.
  //   2. The observer snapshots [data-reveal] once, here. The CMS re-renders a
  //      block on every keystroke, and the replacement elements are never
  //      observed — so they would stay at opacity 0 for good. The editor bridge
  //      dispatches no post-swap event, so there is nothing to re-arm against
  //      short of a MutationObserver.
  //
  // (2) is why relaxing this guard needs more than deleting the condition. An
  // editing surface wants the content, not the entrance.
  const inPreviewFrame = window.self !== window.top
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const revealables = document.querySelectorAll('[data-reveal]')
  if (!reduceMotion && !inPreviewFrame && revealables.length) {
    document.documentElement.classList.add('reveal-ready')
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    )
    revealables.forEach((el) => observer.observe(el))
  }
</script>

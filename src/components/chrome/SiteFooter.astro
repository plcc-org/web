---
import { withBase } from '../../lib/url'
import { church, serviceTimeDisplay } from '../../config/church'
// SVG icons live outside src/assets/images on purpose: that directory is the
// CMS media root, and an SVG in it shows up in the photo picker but silently
// fails to render (the image globs accept raster formats only).
import instagramGlyphUrl from '../../assets/icons/Instagram_Glyph_White.svg?url'
import youtubeIconUrl from '../../assets/images/yt_icon_white_digital.png?url'
import podcastIconUrl from '../../assets/icons/podcast_icon_white.svg?url'
---

<footer class="site-footer">
  <div class="site-footer__main">
    {/* The nav is capped at eight items, which leaves every page below a hub reachable
        only from that hub. These columns are the persistent path to them. */}
    <nav class="site-footer__sitemap" aria-label="Footer">
      <div class="site-footer__column">
        <div class="site-footer__group">
          <h2 class="site-footer__heading">Visit</h2>
          <ul>
            <li>
              <a href={withBase('new/')}>I’m New</a>
            </li>
            <li>
              <a href={withBase('visit/')}>Plan a Visit</a>
            </li>
            <li>
              <a href={withBase('events/')}>What’s On</a>
            </li>
            <li>
              <a href={withBase('messages/')}>Messages</a>
            </li>
            <li>
              <a href={withBase('contact/')}>Contact</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="site-footer__column">
        <div class="site-footer__group">
          <h2 class="site-footer__heading">
            <a href={withBase('about/')}>About</a>
          </h2>
          <ul>
            <li>
              <a href={withBase('about/leadership/')}>Leadership</a>
            </li>
            <li>
              <a href={withBase('about/pastors-letter/')}>A Welcome from Austin Bailey</a>
            </li>
            <li>
              <a href={withBase('vision/')}>Mission &amp; Vision</a>
            </li>
            <li>
              <a href={withBase('beliefs/')}>What We Believe</a>
            </li>
            <li>
              <a href={withBase('about/covenant/')}>The Evangelical Covenant Church</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="site-footer__column">
        <div class="site-footer__group">
          <h2 class="site-footer__heading">
            <a href={withBase('families/')}>Families</a>
          </h2>
          <ul>
            <li>
              <a href={withBase('kids/')}>Pine Lake Kids</a>
            </li>
            <li>
              <a href={withBase('youth/')}>Pine Lake Youth</a>
            </li>
            <li>
              <a href={withBase('momco/')}>MomCo</a>
            </li>
          </ul>
        </div>
        <div class="site-footer__group">
          <h2 class="site-footer__heading">
            <a href={withBase('church-life/')}>Church Life</a>
          </h2>
          <ul>
            <li>
              <a href={withBase('church-life/pine-lake-academy/')}>Pine Lake Academy</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="site-footer__column">
        <div class="site-footer__group">
          <h2 class="site-footer__heading">
            <a href={withBase('neighbors/')}>For Our Neighbors</a>
          </h2>
          <ul>
            <li>
              <a href={withBase('neighbors/care/')}>Care &amp; Support</a>
            </li>
            <li>
              <a href={withBase('neighbors/meals/')}>Meals of Care</a>
            </li>
            <li>
              <a href={withBase('neighbors/serve/')}>Serving Locally</a>
            </li>
            <li>
              <a href={withBase('neighbors/stephen-ministry/')}>Stephen Ministry</a>
            </li>
            <li>
              <a href={withBase('neighbors/weddings/')}>Weddings &amp; Memorials</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="site-footer__info">
      <strong>{church.name}</strong>
      <span class="site-footer__divider">|</span>
      <span>
        {church.service.day}s at {serviceTimeDisplay()}
      </span>
      <span class="site-footer__divider">|</span>
      <a href={church.mapUrl} target="_blank" rel="noopener">
        {church.addressLine}
      </a>
      <span class="site-footer__divider">|</span>
      <a href={`mailto:${church.email}`}>{church.email}</a>
    </div>

    <div class="site-footer__links">
      <a href={church.social.instagram} target="_blank" rel="noopener" class="site-footer__social-link">
        <img
          src={instagramGlyphUrl}
          alt=""
          aria-hidden="true"
          class="site-footer__social-icon site-footer__social-icon--instagram"
        />
        <span>Instagram</span>
      </a>
      <span class="site-footer__divider">|</span>
      <a href={church.social.youtube} target="_blank" rel="noopener" class="site-footer__social-link">
        <img
          src={youtubeIconUrl}
          alt=""
          aria-hidden="true"
          class="site-footer__social-icon site-footer__social-icon--youtube"
        />
        <span>YouTube</span>
      </a>
      <span class="site-footer__divider">|</span>
      <a href={church.social.podcast} target="_blank" rel="noopener" class="site-footer__social-link">
        <img
          src={podcastIconUrl}
          alt=""
          aria-hidden="true"
          class="site-footer__social-icon site-footer__social-icon--podcast"
        />
        <span>Podcast</span>
      </a>
    </div>

    <p class="site-footer__legal">
      © {new Date().getFullYear()} {church.name}
    </p>
  </div>
</footer>

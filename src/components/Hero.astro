---
import type { ImageMetadata } from 'astro'
import Photo from './Photo.astro'

// Full-bleed cinematic hero: photos cross-faded behind the headline as a slow,
// blurred drift. The `video` path is dormant but kept deliberately — no CMS
// field feeds it yet, and when one does, the glow-gradient stand-in, fade-in
// and reduced-motion/no-script fallbacks below are the behaviour it needs.

type ImageItem = { image: ImageMetadata; alt: string }
type Props = {
  video?: string
  /** The drift stack, resolved with each pane's alt (see PageHero). */
  images?: ImageItem[]
  eyebrow?: string
  title: string
  subhead?: string
  /** Visual-editor marker; see src/lib/tina/block-field.ts. */
  tinaField?: string
}

const { video, images = [], eyebrow, title, subhead, tinaField } = Astro.props

const heroPanes = images
const usePhotos = heroPanes.length > 0
---

{
  /* Arm the staggered entrance pre-paint (only when motion is welcome), so the
   content never flashes visible-then-hidden and stays fully visible without JS
   or under reduced motion. is:inline runs synchronously, before the hero paints;
   a normal hoisted <script> would run too late. */
}
<script is:inline>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hero-enter')
  }
</script>

<section
  data-tina-field={tinaField}
  class:list={['hero', { 'hero--has-video': video && !usePhotos, 'hero--photos': usePhotos }]}
  data-hero
>
  <div class="hero__media">
    {
      usePhotos && (
        <div class="hero__strip" aria-hidden="true" style={`--pane-count:${heroPanes.length}`}>
          {heroPanes.map((pane, i) => (
            <div class="hero__pane" style={`--pane-index:${i}`}>
              {/* Well below what a sharp full-bleed image would need: at a 10px
                  blur a 720px source upscales without visible artefacts, so
                  paying for 1440 buys nothing. Checked by forcing each width
                  and comparing. */}
              <Photo
                image={pane.image}
                alt={pane.alt}
                class="hero__pane-img"
                widths={[480, 720, 960]}
                sizes="100vw"
                loading="eager"
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </div>
          ))}
        </div>
      )
    }
    {
      video && !usePhotos && (
        <video class="hero__video" muted loop playsinline autoplay preload="none" aria-hidden="true" tabindex="-1">
          {/* src is held in data-src so nothing downloads until the script opts in */}
          <source data-src={video} type="video/mp4" />
        </video>
      )
    }
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      {eyebrow && <p class="eyebrow hero__eyebrow">{eyebrow}</p>}
      <h1 class="hero__title">{title}</h1>
      {subhead && <p class="hero__subhead">{subhead}</p>}
      <slot />
    </div>
  </div>
</section>

<script>
  for (const hero of document.querySelectorAll('[data-hero]')) {
    const video = hero.querySelector('.hero__video') as HTMLVideoElement | null
    if (!video) continue

    const params = new URLSearchParams(window.location.search)
    const disabled = params.get('video') === '0'
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Fall back to the still photo: skip the video entirely so it never downloads.
    if (disabled || reduceMotion) {
      hero.classList.remove('hero--has-video')
      hero.classList.add('hero--no-video')
      video.remove()
      continue
    }

    const source = video.querySelector('source') as HTMLSourceElement | null
    if (source && source.dataset.src) {
      source.src = source.dataset.src
    }

    // Fade the video in only once it actually has frames to show.
    video.addEventListener('playing', () => hero.classList.add('hero--video-ready'), { once: true })

    video.load()
    const attempt = video.play()
    if (attempt && typeof attempt.catch === 'function') {
      attempt.catch(() => {})
    }
  }
</script>

---
import Photo from './Photo.astro'

// Full-bleed cinematic hero. While the background video loads, a soft "glow"
// gradient stands in; the video then fades in on top once it can play. A still
// photo is shown instead when motion is reduced, when scripting is unavailable,
// or when the page is loaded with ?video=0.

type Props = {
  video?: string
  /** Photos cross-faded behind the headline as a slow, blurred drift. */
  photos?: string[]
  filename?: string
  alt?: string
  eyebrow?: string
  title: string
  subhead?: string
}

// alt is optional: omit for catalogued photos (looked up by filename in <Photo>).
const { video, photos, filename, alt, eyebrow, title, subhead } = Astro.props
const heroPhotos = photos ?? []
const usePhotos = heroPhotos.length > 0
---

{
  /* Arm the staggered entrance pre-paint (only when motion is welcome), so the
   content never flashes visible-then-hidden and stays fully visible without JS
   or under reduced motion. is:inline runs synchronously, before the hero paints;
   a normal hoisted <script> would run too late. */
}
<script is:inline>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hero-enter')
  }
</script>

<section class:list={['hero', { 'hero--has-video': video && !usePhotos, 'hero--photos': usePhotos }]} data-hero>
  <div class="hero__media">
    {
      usePhotos && (
        <div class="hero__strip" aria-hidden="true" style={`--pane-count:${heroPhotos.length}`}>
          {heroPhotos.map((name, i) => (
            <div class="hero__pane" style={`--pane-index:${i}`}>
              {/* Deliberately tiny: these are blurred past the point where
                  resolution is visible, so a 480px source upscales invisibly
                  and the whole hero costs a fraction of one video. */}
              <Photo
                filename={name}
                class="hero__pane-img"
                widths={[320, 480]}
                sizes="480px"
                loading="eager"
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </div>
          ))}
        </div>
      )
    }
    {
      !usePhotos && filename && (
        <Photo
          filename={filename}
          alt={alt}
          class="hero__img"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    {
      video && !usePhotos && (
        <video class="hero__video" muted loop playsinline autoplay preload="none" aria-hidden="true" tabindex="-1">
          {/* src is held in data-src so nothing downloads until the script opts in */}
          <source data-src={video} type="video/mp4" />
        </video>
      )
    }
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      {eyebrow && <p class="eyebrow hero__eyebrow">{eyebrow}</p>}
      <h1 class="hero__title">{title}</h1>
      {subhead && <p class="hero__subhead">{subhead}</p>}
      <slot />
    </div>
  </div>
</section>

<script>
  for (const hero of document.querySelectorAll('[data-hero]')) {
    const video = hero.querySelector('.hero__video') as HTMLVideoElement | null
    if (!video) continue

    const params = new URLSearchParams(window.location.search)
    const disabled = params.get('video') === '0'
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Fall back to the still photo: skip the video entirely so it never downloads.
    if (disabled || reduceMotion) {
      hero.classList.remove('hero--has-video')
      hero.classList.add('hero--no-video')
      video.remove()
      continue
    }

    const source = video.querySelector('source') as HTMLSourceElement | null
    if (source && source.dataset.src) {
      source.src = source.dataset.src
    }

    // Fade the video in only once it actually has frames to show.
    video.addEventListener('playing', () => hero.classList.add('hero--video-ready'), { once: true })

    video.load()
    const attempt = video.play()
    if (attempt && typeof attempt.catch === 'function') {
      attempt.catch(() => {})
    }
  }
</script>

---
import { withBase } from '../lib/url'

type Props = {
  title: string
  intro: string
  body: string
  bullets: string[]
  ctaLabel: string
  href: string
}

const { title, intro, body, bullets, ctaLabel, href } = Astro.props
---

<article class="door">
  <header class="door__header">
    <!-- <div class="door__badge" aria-hidden="true">Door</div> -->
    <h2 class="door__title">{title}</h2>
  </header>

  <p class="door__intro">{intro}</p>
  <p class="door__body">{body}</p>

  <ul class="door__list">
    {bullets.map((b) => <li>{b}</li>)}
  </ul>

  <p class="door__cta">
    <a class="door__link" href={withBase(href)}>
      {ctaLabel}
      <span aria-hidden="true">→</span>
    </a>
  </p>
</article>

<style>
  .door {
    position: relative;
    padding: clamp(1.75rem, 3.2vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-mist);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }

  .door:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(106, 149, 41, 0.4);
  }

  .door__badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--color-mist);
    color: var(--color-clay);
    font-weight: 600;
    text-transform: uppercase;
  }

  .door__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    margin-top: 0;
    color: var(--color-forest);
  }

  .door__link {
    color: var(--color-moss);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--color-mist);
  }

  .door__link:hover {
    border-bottom-color: var(--color-moss);
  }
</style>

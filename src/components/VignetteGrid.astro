---
import { Image } from 'astro:assets'

type Props = {
  images: any[]
  ariaLabel?: string
}

const { images, ariaLabel = 'Vignettes from Pine Lake' } = Astro.props
---

<div class="vignette-grid" aria-label={ariaLabel}>
  {
    images.map((img, index) => {
      let className = 'vignette'
      if (index === 0 || index === 4) className += ' vignette--wide'
      if (index === 1) className += ' vignette--tall'

      return (
        <div class={className}>
          <Image
            src={img}
            alt={`Moment from the Pine Lake community (${index + 1})`}
            sizes="(max-width: 800px) 50vw, 400px"
            class="vignette-img"
          />
        </div>
      )
    })
  }
</div>

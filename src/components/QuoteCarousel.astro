---
// The home "voices" band: a row of testimonials. Where there's room they sit
// side by side; on a narrow screen the row scrolls sideways, snapping one quote
// to the centre with the next peeking in at the edge to say there's more. The
// browser does all of it, with swipe, trackpad and arrow keys, so there's no
// script, nothing moves on its own, and every quote is reachable without JS.
//
// The row is focusable so a keyboard can scroll it, and labelled so that stop
// announces something.

type Quote = { text: string; by?: string }

type Props = {
  quotes: Quote[]
}

const { quotes } = Astro.props
---

<ul class="quote-row" role="list" tabindex="0" aria-label="Quotes">
  {quotes.map((quote) => (
    <li class="quote-row__item">
      <figure class="story-quote">
        <blockquote>
          <p>{quote.text}</p>
        </blockquote>
        {quote.by && (
          <figcaption>
            <span aria-hidden="true">— </span>
            {quote.by}
          </figcaption>
        )}
      </figure>
    </li>
  ))}
</ul>

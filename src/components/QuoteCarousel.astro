---
// A single-quote carousel for the home "voices" band. One testimonial is
// visible at a time; the rest crossfade in on a timer or when the visitor
// uses the dots / arrows. All quotes are rendered server-side (good for SEO
// and no-JS) and stacked in one grid cell, so the viewport sizes itself to
// the tallest quote and nothing jumps as they rotate.
//
// Accessibility: the slides are deliberately NOT a live region. Marking them
// aria-live would read a testimonial to a screen-reader user every 7 seconds,
// unprompted, for as long as they stayed on the page. Instead a visually-hidden
// status line announces only when the visitor works the controls themselves —
// the pattern the ARIA Authoring Practices carousel guidance describes.
// Timer-driven changes stay silent; inactive slides are visibility:hidden, so
// they're out of the accessibility tree either way.

type Quote = { text: string; by?: string }

type Props = {
  quotes: Quote[]
}

const { quotes } = Astro.props
---

<div class="quote-carousel" data-quote-carousel>
  <div class="quote-carousel__viewport">
    {
      quotes.map((quote, i) => (
        <blockquote class:list={['story-quote', 'quote-slide', i === 0 && 'is-active']} aria-hidden={i !== 0}>
          <p>{quote.text}</p>
          {quote.by && <footer>— {quote.by}</footer>}
        </blockquote>
      ))
    }
  </div>

  {
    quotes.length > 1 && (
      <div class="quote-carousel__controls">
        <button type="button" class="quote-nav" data-dir="prev" aria-label="Previous quote">
          <span aria-hidden="true">←</span>
        </button>
        <div class="quote-dots" role="group" aria-label="Choose a quote">
          {quotes.map((_, i) => (
            <button
              type="button"
              class:list={['quote-dot', i === 0 && 'is-active']}
              data-index={i}
              aria-label={`Quote ${i + 1} of ${quotes.length}`}
              aria-current={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
        <button type="button" class="quote-nav" data-dir="next" aria-label="Next quote">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    )
  }

  {/* Announces the new position, but only when the visitor moved it themselves. */}
  <p class="visually-hidden" role="status" data-quote-status></p>
</div>

<style>
  .quote-carousel {
    margin-top: var(--space-md);
  }

  /* All slides share one grid cell, so the viewport is as tall as the
     longest quote and the layout never shifts as quotes rotate. */
  .quote-carousel__viewport {
    display: grid;
  }

  /* Out of the card: let the quote sit in open space. Drop the paper panel,
     border, and shadow inherited from .story-quote; keep the centered serif
     type and the moss accent rule. */
  .quote-slide {
    grid-area: 1 / 1;
    max-width: var(--measure-wide);
    margin-inline: auto;
    padding: 0;
    background: none;
    border: 0;
    box-shadow: none;
    text-align: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out),
      visibility 0s linear var(--duration-slow);
  }

  .quote-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  /* Solo quote: larger and centered, with the accent rule centered too. */
  .quote-slide :global(p) {
    font-size: var(--text-lg);
  }

  .quote-slide::before {
    margin-inline: auto;
  }

  .quote-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .quote-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-forest);
    font-size: var(--text-md);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .quote-nav:hover {
    background: var(--color-white);
    border-color: var(--color-moss);
    transform: translateY(-1px);
  }

  .quote-nav:focus-visible {
    outline: 2px solid var(--color-moss);
    outline-offset: 2px;
  }

  .quote-dots {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .quote-dot {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-line);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .quote-dot:hover {
    background: var(--color-clay);
  }

  .quote-dot.is-active {
    background: var(--color-ember);
    transform: scale(1.3);
  }

  .quote-dot:focus-visible {
    outline: 2px solid var(--color-moss);
    outline-offset: 2px;
  }
</style>

<script>
  function initQuoteCarousel(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.quote-slide'))
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.quote-dot'))
    const status = root.querySelector<HTMLElement>('[data-quote-status]')
    if (slides.length <= 1) return

    let current = 0
    let timer: ReturnType<typeof setInterval> | undefined
    const ROTATE_MS = 7000

    // `announce` is true only for visitor-driven changes — see the note at the
    // top of this file on why the timer must stay silent.
    const show = (next: number, announce = false) => {
      const index = (next + slides.length) % slides.length
      if (index === current) return

      slides[current].classList.remove('is-active')
      slides[current].setAttribute('aria-hidden', 'true')
      dots[current]?.classList.remove('is-active')
      dots[current]?.setAttribute('aria-current', 'false')

      current = index

      slides[current].classList.add('is-active')
      slides[current].setAttribute('aria-hidden', 'false')
      dots[current]?.classList.add('is-active')
      dots[current]?.setAttribute('aria-current', 'true')

      if (announce && status) status.textContent = `Quote ${current + 1} of ${slides.length}`
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const start = () => {
      if (prefersReducedMotion || timer) return
      timer = setInterval(() => show(current + 1), ROTATE_MS)
    }

    const stop = () => {
      if (!timer) return
      clearInterval(timer)
      timer = undefined
    }

    // Manual controls restart the timer so the visitor's last action sets the pace.
    root.querySelectorAll<HTMLButtonElement>('.quote-nav').forEach((btn) => {
      btn.addEventListener('click', () => {
        stop()
        show(current + (btn.dataset.dir === 'prev' ? -1 : 1), true)
        start()
      })
    })

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stop()
        show(i, true)
        start()
      })
    })

    // Pause while the visitor is reading (hover) or interacting (focus).
    root.addEventListener('mouseenter', stop)
    root.addEventListener('mouseleave', start)
    root.addEventListener('focusin', stop)
    root.addEventListener('focusout', start)

    // ...and while the tab is in the background, where rotating burns a timer
    // wake-up every 7s to animate something nobody is looking at.
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()))

    start()
  }

  document.querySelectorAll<HTMLElement>('[data-quote-carousel]').forEach((el) => initQuoteCarousel(el))
</script>
